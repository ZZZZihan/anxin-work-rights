[Unit]
Description=Anxin local-cloud test instance
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.local/lib/anxin/current
Environment=ANXIN_CONFIG=%h/.config/anxin/config.json
Environment=NODE_ENV=production
ExecStart=/usr/local/bin/node deploy/local-cloud/server.mjs
Restart=on-failure
RestartSec=5
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
