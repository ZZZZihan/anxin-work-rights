+// A stated RMB conversion result is already denominated; do not infer an FX
+// rate. Remove only its immediately preceding foreign+conversion operator from
+// this detection edge. Other prefix markers and every suffix still get checked.
+// A plain 元 unit or a detached RMB mention is insufficient for this exception.
+function beforeExplicitRmbConversion(before: string, token: string, after: string): string {
+  const target = before.match(RMB_PREFIX);
+  const conversionBefore = target ? before.slice(0, target.index) : before;
+  if (!target && !EXPLICIT_RMB_IN_TOKEN.test(token) && !EXPLICIT_RMB_AFTER.test(after)) return before;
+  const conversion = conversionBefore.match(EXPLICIT_RMB_CONVERSION);
+  if (!conversion) return before;
+  return before.slice(0, conversion.index) + '()' + (target ? before.slice(target.index) : '');
+}
