"""Read the single completed integration attempt. Never run tests or alter ROOT."""
from pathlib import Path
import collections
import hashlib
import json
import re

D = Path(__file__).resolve().parent
sha = lambda value: hashlib.sha256(value).hexdigest()
execution = json.loads((D / 'v20-root-full-check-independent.execution.json').read_bytes())
stdout_bytes = (D / 'v20-root-full-check-independent.stdout.txt').read_bytes()
stderr_bytes = (D / 'v20-root-full-check-independent.stderr.txt').read_bytes()
assert sha(stdout_bytes) == execution['stdout_sha256']
assert sha(stderr_bytes) == execution['stderr_sha256']
assert execution['exit_code'] == 1
assert execution['protected_files'] == 320
assert execution['protected_before_after_identical'] and not execution['changed_protected_files']
text = stdout_bytes.decode()
lines = text.splitlines()
summaries = []
pattern = r'(?m)^ℹ tests (\d+)\nℹ suites (\d+)\nℹ pass (\d+)\nℹ fail (\d+)\nℹ cancelled (\d+)\nℹ skipped (\d+)\nℹ todo (\d+)\nℹ duration_ms ([0-9.]+)'
for m in re.finditer(pattern, text):
    summaries.append(dict(zip(('tests', 'suites', 'pass', 'fail', 'cancelled', 'skipped', 'todo', 'duration_ms'),
        [int(x) for x in m.groups()[:-1]] + [float(m.group(8))])))
assert summaries[0]['pass'] == 67 and summaries[0]['fail'] == 0 and summaries[0]['skipped'] == 1
assert summaries[1]['tests'] == 6862 and summaries[1]['pass'] == 6811 and summaries[1]['fail'] == 50 and summaries[1]['skipped'] == 1
fail_detail = next(i for i, line in enumerate(lines) if line == '✖ failing tests:')
failed_first = [(i + 1, line) for i, line in enumerate(lines[:fail_detail]) if re.match(r'\s*✖ .* \([0-9.]+ms\)$', line)]
leaves = []
starts = [i for i in range(fail_detail, len(lines)) if lines[i].startswith('test at scripts/')]
for n, start in enumerate(starts):
    end = starts[n + 1] if n + 1 < len(starts) else len(lines)
    block = lines[start:end]
    body = '\n'.join(block)
    location = block[0][8:]
    name = block[1]
    signature = ('shared_absolute_deadline_exhausted' if 'Shared historical execution deadline exhausted' in body
        else 'child_timeout_reported' if 'ETIMEDOUT' in body
        else 'expected_cli_exit1_but_status_null' if 'null !== 1' in body
        else 'expected_cli_exit1_but_status_undefined' if 'undefined !== 1' in body
        else 'expected_fixture_success_but_status_null' if 'null !== 0' in body
        else 'expected_rejection_diagnostic_missing_or_different')
    leaves.append({'source_location': location, 'stdout_detail_line': start + 1, 'result_line': name,
        'elapsed_ms': float(re.search(r'\(([0-9.]+)ms\)$', name).group(1)),
        'observed_signature': signature, 'detail_sha256': sha(body.encode()),
        'bounded_excerpt': [s[:400] for s in block[2:10] if len(s) < 600]})
assert len(leaves) == 32
assert len(failed_first) == 50
names = [
    'the current v20 manifest binds 79 exact dependencies in the v7 experiment family',
    'the v19 wrapper restores all 76 historical dependencies and cleans up when the callback throws',
    'the actual v20 CLI refuses JSON-equivalent current manifest whitespace',
    'the actual v20 CLI refuses comment-only whole-amount guard drift after archived v19 verification',
]
gates = []
for name in names:
    found = [(i + 1, line) for i, line in enumerate(lines[:fail_detail])
        if re.match(r'\s*[✔✖] ' + re.escape(name) + r' \([0-9.]+ms\)$', line)]
    assert len(found) == 1
    number, line = found[0]
    gates.append({'name': name, 'result': 'PASS' if '✔' in line else 'FAIL', 'stdout_line': number,
        'elapsed_ms': float(re.search(r'\(([0-9.]+)ms\)$', line).group(1))})
assert [g['result'] for g in gates] == ['PASS', 'PASS', 'FAIL', 'PASS']
gates[2]['failure_reason'] = 'Actual CLI stderr contains shared historical deadline exhaustion; expected v20 manifest-byte diagnostic was not reached. This is not a valid successful negative test.'
gates[3]['child_evidence_boundary'] = 'Passing executed assertions require child status 1 and the expected current manifest diagnostic; the reporter prints test outcome rather than separate raw child status.'
outer = [(i + 1, line) for i, line in enumerate(lines[:fail_detail]) if re.match(r'✖ v20 preserves v19 and binds .* \([0-9.]+ms\)$', line)]
assert len(outer) == 1
result = {'schema': 'material-facts-v7-v20-independent-full-check-failure/1',
    'status': 'FAIL_FULL_INTEGRATION_APPLICATION_BLOCKED_NEW_REVIEW',
    'command': execution['command'], 'node': execution['node'],
    'started_at_utc': execution['started_at_utc'], 'finished_at_utc': execution['finished_at_utc'],
    'elapsed_seconds': execution['elapsed_seconds'], 'exit_code': 1,
    'vitest': {'files_pass': 46, 'tests_pass': 1789}, 'node_summaries': summaries,
    'python_suite_counts': [int(x) for x in re.findall(r'Ran (\d+) tests? in', stderr_bytes.decode())],
    'failed_reporter_entries_including_parents': len(failed_first), 'failed_leaf_entries': len(leaves),
    'failed_parent_entries': len(failed_first) - len(leaves),
    'failure_signature_counts': dict(collections.Counter(x['observed_signature'] for x in leaves)),
    'failed_leaves': leaves, 'v20_subtests': gates,
    'v20_outer': {'result': 'FAIL', 'stdout_line': outer[0][0], 'text': outer[0][1]},
    'v20_five_entries_including_outer': {'pass': 3, 'fail': 2, 'skip': 0},
    'source_observations': [
        {'file': 'scripts/material-facts-v7-correction-v2-gates.test.mjs', 'line': 87,
         'observation': '60000ms fixture timeout; failed after 60019.96ms with empty stderr. Timeout-like failure, not proof the corruption was correctly rejected.'},
        {'file': 'scripts/material-facts-v7-run-lifecycle.test.mjs', 'line': 148,
         'observation': 'Synthetic runner execute has timeout 6000ms and SIGKILL. Backpressure test line188 got null instead of successful code0 after6480.65ms; metrics assertions were not reached.'},
        {'file': 'scripts/material-facts-v7-correction-v20-gates-independent.test.mjs', 'line': 86,
         'observation': 'Expected manifest-byte diagnostic differs from actual shared deadline exhaustion. Assertion correctly fails rather than count arbitrary exit1 as a valid refusal.'},
        {'file': 'experiments/material-facts-v7/historical-execution-policy-v1.mjs', 'line': 64,
         'observation': 'Actual v20 negative CLI emitted ETIMEDOUT from exhausted inherited historical budget; no timeout policy was changed.'}],
    'resource_causality': 'Large concurrent process population observed, but one run alone does not establish sole root cause. No observed proof of OOM or disk exhaustion. Do not relabel failures as passes.',
    'protected_files': 320, 'protected_before_after_identical': True,
    'source_stdout_sha256': execution['stdout_sha256'], 'source_stderr_sha256': execution['stderr_sha256'],
    'new_model_requests': 0, 'separate_gate_run_in_this_attempt': False,
    'automatic_retry': False, 'test_concurrency_changed': False,
    'prepared_success_log_reviewer_executed': False,
    'evidence_boundary': 'Lightweight artifact binding/count audit passes independently; the authorized once-only complete ROOT integration check fails. Parent-run HTTP and remote application CI are different evidence. New review findings remain pending.'}
assert result['python_suite_counts'] == [9, 11, 16]
print(json.dumps(result, ensure_ascii=False, indent=2))
