import assert from 'node:assert/strict';
import { createHash } from 'node:crypto';
import { readFile, readdir } from 'node:fs/promises';
import { resolve } from 'node:path';
import { pathToFileURL } from 'node:url';

// Read-only metadata and owned-temporary restoration checks. No scoring CLI,
// computeCorrection, HTTP service, or model is started by this script.
const ROOT = process.env.V7_REVIEW_ROOT;
assert(ROOT);
const E = 'experiments/material-facts-v7';
const sha = bytes => createHash('sha256').update(bytes).digest('hex');
const bytes = path => readFile(resolve(ROOT, path));
const json = async path => JSON.parse(await bytes(path));
const original = '3733e4c6939184fbe79b56e4a4bdc2db35f4e6f99a20fc91c48bd24913ce53ee';
const v19 = '5f39f3870bf50c03bb8d202a021c6643c5000f770259005ebd6cfe4ac64033c7';
const policy = 'cf6a04377e518064037cb3374591eb7747972f7259aa92ffa0f8440eefde7dea';
const adapter = '0796452771e29dcf6ae5cfd653cb96a851a713f07de9f2b6e2754feb50586a8c';
const names = ['freeze.json', 'result-manifest.json', 'corrections/manifest.json',
  ...Array.from({ length: 18 }, (_, i) => `corrections-v${i + 2}/manifest.json`),
  'correction-code-v19/manifest.json', 'historical-execution-policy-v1.mjs', 'historical-execution-v1.mjs'];
const before = Object.fromEntries(await Promise.all(names.map(async name => [name, sha(await bytes(`${E}/${name}`))])));
assert.equal(before['result-manifest.json'], original);
assert.equal(before['corrections-v19/manifest.json'], v19);
assert.equal(before['historical-execution-policy-v1.mjs'], policy);
assert.equal(before['historical-execution-v1.mjs'], adapter);
for (let version = 2; version <= 19; version++) {
  const current = await json(`${E}/corrections-v${version}/manifest.json`);
  assert.equal(current.schema, `material-facts-v7-postfreeze-correction-manifest/${version}`);
  const previousName = version === 2 ? 'corrections/manifest.json' : `corrections-v${version - 1}/manifest.json`;
  assert.equal(current.previous_correction_manifest_sha256, before[previousName]);
}
const previous = await json(`${E}/corrections-v19/manifest.json`);
const archive = await json(`${E}/correction-code-v19/manifest.json`);
assert.equal(archive.schema, 'material-facts-v7-correction-code/19');
assert.equal(archive.correction_manifest_sha256, v19);
assert.equal(archive.correction_directory, 'corrections-v19');
assert.equal(archive.storage_suffix, '.snapshot');
assert.equal(Object.keys(previous.code_sha256).length, 76);
assert.deepEqual(archive.files, previous.code_sha256);
async function filesAt(path) {
  const result = [];
  for (const entry of await readdir(resolve(ROOT, path), { withFileTypes: true })) {
    const next = `${path}/${entry.name}`;
    if (entry.isDirectory()) result.push(...await filesAt(next));
    else { assert(entry.isFile(), 'Archive contains a non-file entry'); result.push(next); }
  }
  return result;
}
assert.deepEqual((await filesAt(`${E}/correction-code-v19`)).sort(),
  [`${E}/correction-code-v19/manifest.json`, ...Object.keys(archive.files).map(path => `${E}/correction-code-v19/${path}.snapshot`)].sort());
for (const [path, digest] of Object.entries(archive.files))
  assert.equal(sha(await bytes(`${E}/correction-code-v19/${path}.snapshot`)), digest, path);
const newPaths = [`${E}/historical-v19-execution.mjs`, `${E}/verify-correction-v19.mjs`, `${E}/corrective-assessment-v20.mjs`];
const intended = [...new Set([...Object.keys(previous.code_sha256), ...newPaths])].sort();
assert.equal(intended.length, 79);
for (let version = 9; version <= 19; version++) {
  assert(intended.includes(`${E}/historical-v${version}-execution.mjs`));
  assert(intended.includes(`${E}/verify-correction-v${version}.mjs`));
  assert(intended.includes(`${E}/corrective-assessment-v${version}.mjs`));
}
const oldBridge = (await bytes(`${E}/historical-v18-execution.mjs`)).toString();
const newBridge = (await bytes(newPaths[0])).toString();
assert.equal(newBridge, oldBridge.replaceAll('v18', 'v19').replaceAll('V18', 'V19'));
const { withCorrectionV19Code } = await import(pathToFileURL(resolve(ROOT, newPaths[1])));
const expected = new Error('Independent synthetic callback cleanup boundary');
let owned;
await assert.rejects(withCorrectionV19Code(async temporary => {
  owned = temporary;
  for (const [path, digest] of Object.entries(previous.code_sha256))
    assert.equal(sha(await readFile(resolve(temporary, path))), digest, path);
  throw expected;
}, ROOT), error => error === expected);
assert(owned);
await assert.rejects(readFile(resolve(owned, 'package.json')), { code: 'ENOENT' });
for (const [name, digest] of Object.entries(before)) assert.equal(sha(await bytes(`${E}/${name}`)), digest, name);
const reviewed = [...newPaths, 'scripts/material-facts-v7-correction-v20-gates-independent.test.mjs',
  'scripts/material-facts-v7-historical-v19-execution.test.mjs'];
console.log(JSON.stringify({ status: 'PASS', historical_manifests: before, historical_archive_paths: 76,
  next_intended_code_paths: 79, next_result_written: false, historical_cli_run: false, model_requests: 0,
  bridge_only_version_rename: true, owned_restore_and_callback_cleanup: true,
  reviewed_sha256: Object.fromEntries(await Promise.all(reviewed.map(async path => [path, sha(await bytes(path))]))) }, null, 2));
