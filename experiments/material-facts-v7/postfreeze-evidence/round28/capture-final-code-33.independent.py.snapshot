from pathlib import Path
import subprocess,os,time,json,datetime,hashlib,concurrent.futures,re
own=Path('/Users/xuzihan/Documents/Projects/国创/anxin-facts-v7-review');root=own.parent/'anxin-facts-v7-code-review';ev=own/'postfreeze-evidence/round28'
scripts=[own/'scripts/material-facts-v7-round28-independent.test.mjs',own/'scripts/material-facts-v7-round28-name-cross-independent.test.mjs']
sha=lambda p:hashlib.sha256(p.read_bytes()).hexdigest()
paths=['lib/material-money-v4.ts','lib/material-fact-range-review.ts','lib/material-fact-source-review.ts','lib/material-fact-event-review.ts','lib/material-fact-currency-review.ts','lib/material-fact-runtime-ingest.ts','experiments/material-facts-v7/assess.mjs']
before={p:sha(root/p) for p in paths}
assert before['lib/material-money-v4.ts']=='9418e8552d8af20b3b3da1b389bca74d2288e30549be1b5974df2b25e5bbaacf'
assert before['lib/material-fact-range-review.ts']=='4bb5f5fa446a8bf5dec309e7faa04c18ee8f3c132893a2bacbc65c3875154723'
assert before['lib/material-fact-source-review.ts']=='fd215d6ace9b9b9ce019fd28b5f9f3a4bc35b1e79162a62ca52abc0e31ee5714'
assert before['lib/material-fact-event-review.ts']=='cc35b6a597231967c721ca70bc378e6b8877fc23b10a6e5e634a5bc24f15e010'
for p in paths:(ev/(Path(p).name+'.final-code.snapshot')).write_bytes((root/p).read_bytes())
def run(tag,node):
 stem=ev/('final-code-33-'+tag);at=datetime.datetime.now(datetime.timezone.utc).isoformat();st=time.monotonic()
 with stem.with_suffix('.stdout.txt').open('xb') as out,stem.with_suffix('.stderr.txt').open('xb') as err:
  result=subprocess.run([node,'--test','--test-reporter=tap',*[str(p) for p in scripts]],cwd=root,env={**os.environ,'V7_REVIEW_ROOT':str(root)},stdout=out,stderr=err)
 stdout=stem.with_suffix('.stdout.txt').read_text()
 counts={key:int(re.findall(r'^# '+key+r' (\d+)$',stdout,re.M)[-1]) for key in ['tests','pass','fail','cancelled','skipped']}
 receipt={'root':str(root),'scripts_sha256':{str(p.relative_to(own)):sha(p) for p in scripts},'node':node,'version':subprocess.check_output([node,'--version'],text=True).strip(),'started_at':at,'elapsed_seconds':time.monotonic()-st,'exit_code':result.returncode,'counts':counts,'stdout_sha256':sha(stem.with_suffix('.stdout.txt')),'stderr_sha256':sha(stem.with_suffix('.stderr.txt')),'model_calls':0,'http_calls':0,'historical_chain_calls':0}
 stem.with_suffix('.execution.json').write_text(json.dumps(receipt,ensure_ascii=False,indent=2)+'\n');return receipt
with concurrent.futures.ThreadPoolExecutor(2) as pool:
 for receipt in pool.map(lambda pair:run(*pair),[('node24','/Users/xuzihan/.cache/codex-runtimes/codex-primary-runtime/dependencies/node/bin/node'),('node26','/opt/homebrew/bin/node')]):
  print(json.dumps(receipt,ensure_ascii=False));assert receipt['exit_code']==0 and receipt['counts']=={'tests':33,'pass':33,'fail':0,'cancelled':0,'skipped':0}
after={p:sha(root/p) for p in paths};assert before==after
(ev/'final-code-33-protected.json').write_text(json.dumps({'root':str(root),'before':before,'after':after,'unchanged':True},indent=2)+'\n')
