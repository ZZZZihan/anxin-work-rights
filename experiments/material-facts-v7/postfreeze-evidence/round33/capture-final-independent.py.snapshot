from pathlib import Path
import os, json, subprocess, time, hashlib, shutil, re
OWN=Path(__file__).resolve().parents[2]
CODE=Path('/Users/xuzihan/Documents/Projects/国创/anxin-facts-v7-code-review')
E=Path(__file__).resolve().parent
sha=lambda p:hashlib.sha256(p.read_bytes()).hexdigest()
products={
'lib/material-money-v4.ts':'f25da64312b388662654b174311b3ad569bede44a19c4ec2da227ad0d6af167e',
'lib/material-fact-source-review.ts':'9575c97dc65c81e74ef08a5998b56191030f8e52a0110308bad461cc4077b856',
'lib/material-facts-v3.ts':'77283a7b0677a43a9c3ff62bf78f353dfbfc6f359c63c1388ea81a7f2ccac779',
'scripts/owned-http-process-group.mjs':'b7ab005245c0adfaa7894f447b29ece55d370e50310eae02dd7a615dcf6d4ade'}
assert all(sha(CODE/k)==v for k,v in products.items())
entries=[('product14','scripts/material-facts-v7-round33-independent.test.mjs'),('identity7','scripts/material-facts-http-round33-identity-independent.test.mjs')]
nodes=[('node24',Path('/Users/xuzihan/.npm/_npx/387698761821791d/node_modules/node/bin/node')),('node26',Path(shutil.which('node')))]
for runtime,node in nodes:
 for tag,relative in entries:
    prefix=E/('final-code-'+runtime+'-'+tag)
    assert not prefix.with_suffix('.receipt.json').exists()
    script=OWN/relative
    protected={str(CODE/k):v for k,v in products.items()};protected[str(script)]=sha(script)
    started=time.time();env=os.environ.copy();env['V7_REVIEW_ROOT']=str(CODE)
    out=prefix.with_suffix('.stdout.tap');err=prefix.with_suffix('.stderr.log')
    with out.open('xb') as o,err.open('xb') as e:
      proc=subprocess.run([str(node),'--test',str(script)],env=env,stdout=o,stderr=e,timeout=40)
    result={'entrypoint':[str(node),'--test',str(script)],'root':str(CODE),
      'runtime':subprocess.check_output([str(node),'--version'],text=True).strip(),
      'exit_code':proc.returncode,'seconds':round(time.time()-started,6),
      'products':products,'protected_before':protected,
      'protected_unchanged':{p:sha(Path(p)) for p in protected}==protected,
      'stdout_sha256':sha(out),'stderr_sha256':sha(err),
      'scope':'synthetic pure/runtime/source only' if tag=='product14' else 'controlled builtin API fixture; no native child/process signal',
      'not_http_fullcheck_model_history_cli_or_scorer':True}
    prefix.with_suffix('.receipt.json').write_text(json.dumps(result,ensure_ascii=False,indent=2)+'\n')
    print(json.dumps(result,ensure_ascii=False))
    print(out.read_text()[-12000:])
