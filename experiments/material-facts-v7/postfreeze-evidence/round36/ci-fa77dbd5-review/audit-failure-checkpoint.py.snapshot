"""Parse the failed run's downloaded evidence without rerunning any project code."""
from pathlib import Path
from collections import Counter
import datetime
import hashlib
import json
import re

P = Path(__file__).resolve().parent
HEAD = "fa77dbd5bd9942ed1a94d74293b35160aae1e91b"
def read(name):
    return json.loads((P / name).read_text())
def sha(file):
    return hashlib.sha256(file.read_bytes()).hexdigest()

run = read("terminal-run.json")
job = read("terminal-jobs.json")["jobs"][0]
raw = (P / "original-logs/0_check.txt").read_text()
log = re.sub(r"\x1b\[[0-9;]*m", "", raw)
identity = read("static-identity-at-start.json")
assert run["head_sha"] == HEAD and run["conclusion"] == "failure"
assert f"HEAD is now at {identity['pull_merge_sha_at_read'][:7]} Merge {HEAD}" in log
assert identity["merge_tree_equal_head_tree"]
assert read("merge-commit-api-terminal.json")["tree"]["sha"] == identity["remote_head_tree"]
groups = re.findall(r"ℹ tests (\d+).*?ℹ pass (\d+).*?ℹ fail (\d+).*?ℹ cancelled (\d+).*?ℹ skipped (\d+).*?ℹ duration_ms ([0-9.]+)", log, re.S)
counters = [dict(zip(["tests", "pass", "fail", "cancelled", "skipped", "duration_ms"], [int(v) for v in row[:5]] + [float(row[5])])) for row in groups]
assert len(counters) == 2
assert counters[0]["tests"] == counters[0]["pass"] == 68
assert counters[1]["tests"] == 8892 and counters[1]["pass"] == 8891 and counters[1]["fail"] == 1
assert all(c["cancelled"] == c["skipped"] == 0 for c in counters)
assert re.search(r"Test Files\s+46 passed", log) and re.search(r"Tests\s+1789 passed", log)
assert "test at scripts/material-facts-v7-http-process-tree.test.mjs:75:92" in log
assert "SyntaxError: Unexpected end of JSON input" in log
assert "http-process-tree.test.mjs:69:21" in log
assert "##[error]Process completed with exit code 1." in log
failed_steps = [s for s in job["steps"] if s["conclusion"] == "failure"]
assert [s["name"] for s in failed_steps] == ["Run npm run check"]
assert read("artifacts-terminal.json")["total_count"] == 0
assert read("downloaded-artifacts-manifest.json") == []
for s in job["steps"]:
    if "HTTP" in s["name"]:
        assert s["conclusion"] == "skipped", s
for v in [5, 6]:
    record = next(x for x in read("local-historical-manifests-hashes.json") if x["path"] == f"experiments/material-facts-v{v}/result-manifest.json")
    assert record["sha256"] in log
assert '"execution":"original_v6_verify_and_summary_in_temporary_tree"' in log
assert '"summary_checked":true' in log
reviews = read("review-thread-state-terminal.json")
historical = read("local-original-results-vs-exact-head.json")
summary = {
    "schema": "exact-head-ci-failed-checkpoint/1",
    "recorded_at": datetime.datetime.now(datetime.timezone.utc).isoformat(),
    "status": "CI_FAILED_FIXTURE_READY_JSON_RACE",
    "run_id": run["id"], "run_url": run["html_url"], "head": HEAD,
    "actual_checkout_merge": identity["pull_merge_sha_at_read"],
    "head_and_checkout_tree": identity["remote_head_tree"],
    "head_tree_equals_tested_local_commit_tree": True,
    "job_conclusion": job["conclusion"], "npm_check_exit": 1,
    "step_counts": dict(Counter(s["conclusion"] for s in job["steps"])),
    "steps": job["steps"],
    "environment": {"os": "Ubuntu 24.04.5", "node": "24.21.0", "npm": "11.19.0", "python": "3.12.15"},
    "vitest": {"files": 46, "pass": 1789, "fail": 0},
    "materials": counters[0], "runtime": counters[1],
    "python_in_npm_check": [9, 11, 16], "frozen_baseline_python_groups": [37, 11, 68, 79],
    "failure": {"test": "stop owned HTTP launcher and listening descendant: redirected-ignore-term", "test_definition": "scripts/material-facts-v7-http-process-tree.test.mjs:75:92", "throw_site": "scripts/material-facts-v7-http-process-tree.test.mjs:69:21", "error": "SyntaxError: Unexpected end of JSON input", "duration_ms": 102.658461, "classification": "fixture ready-file publication/read race; not a timeout or failed money assertion", "source_basis": "Leaf writes leaf.json directly; readiness barrier accepts readFile success before JSON completeness; line69 parses immediately. Failure occurs inside fixture before the test calls stopChild.", "suggested_scope": "Publish complete ready JSON atomically or wait for complete validated JSON; preserve socket/whole-group assertions. Parent assigned DATA fixture-only repair; no fix or rerun performed by this audit."},
    "frozen_public_step": {"status": "success", "scope": "v4 original+replication, v5 verify+summary, v6 archived dependency in owned temporary tree+original verify and summary", "new_inference": False, "current_product_validation_from_v6": False},
    "original_results_local_vs_exact_head": {"files": len(historical["files"]), "summaries": historical["summaries"], "all_manifest_sha256_and_git_blob_bindings_match": True},
    "ci_http_ocr_http_cancel_poll_recovery": "SKIPPED after npm check failure; no CI cleanup/raw/restart success claimed",
    "artifact_count": 0, "artifact_digests_verified": None,
    "original_logs": {"zip": f"run{run['id']}-original-logs.zip", "sha256": sha(P / f"run{run['id']}-original-logs.zip"), "members": len(read("original-logs-manifest.json")["entries"])},
    "parent_local_only": {"full_check": read("parent-full-check-final.receipt.json"), "http": read("parent-http410-final-comparison.json"), "not_ci_results": True},
    "reviews_at_terminal_read": {"head": reviews["head_at_review_read"], "observed_at": reviews["observed_at"], "threads": reviews["threads"], "unresolved": len(reviews["unresolved"]), "unresolved_comment_ids": [c["databaseId"] for x in reviews["unresolved"] for c in x["comments"]["nodes"]], "outdated_is_not_resolved": True},
    "github_deployments": {"exact_head_records": len(read("deployments-exact-head-terminal.json")), "checkout_merge_records": len(read("deployments-merge-terminal.json")), "scope": "Only exact two SHA API queries; external deployment state not established"},
    "audit_actions": ["Read-only GitHub API, full original logs ZIP and CLI log download", "Read-only exact commit tree, source snapshots and local historical result SHA checks", "No rerun, comment, review mutation, merge, deployment, model inference, scorer, project build, HTTP or fullcheck run"],
    "author_role_boundary": "This agent authored the event-only R36 patch. This receipt independently audits remote execution evidence; it is not a non-implementer review of that event implementation. DATA performed separate independent tests.",
    "requested_configuration": "GPT-6.1 Sol / ultra; actual backend not independently verifiable",
    "evidence_collection_corrections": "collector-corrections.json; no CI failure or historical record overwritten",
}
with (P / "ci-fa77dbd5-review.independent.json").open("x") as out:
    json.dump(summary, out, ensure_ascii=False, indent=2)
    out.write("\n")
print(json.dumps({"status": summary["status"], "runtime": counters[1], "steps": summary["step_counts"], "historical_files": len(historical["files"]), "artifacts": 0, "reviews_unresolved": len(reviews["unresolved"])}))
