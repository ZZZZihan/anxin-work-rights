// ROUND36 finite conjunction bounds and complete monthly-classifier aliases.
// Synthetic module checks only: no scorer, HTTP, model or historical CLI.
import test, { after } from 'node:test';
import assert from 'node:assert/strict';
import { cp, mkdtemp, rm } from 'node:fs/promises';
import { tmpdir } from 'node:os';
import { resolve } from 'node:path';
import { fileURLToPath, pathToFileURL } from 'node:url';

const OWN = fileURLToPath(new URL('../', import.meta.url));
const BASE = resolve(process.env.MATERIAL_FACT_TEST_ROOT || OWN);
const PATCH = resolve(process.env.MATERIAL_FACT_PATCH_ROOT || OWN);
const minimal = process.env.MATERIAL_FACT_TEST_MINIMAL === '1';
const temporary = await mkdtemp(resolve(tmpdir(), 'anxin-round36-money-'));
after(() => rm(temporary, { recursive: true, force: true }));
await cp(resolve(BASE, 'lib'), resolve(temporary, 'lib'), { recursive: true });
for (const name of ['material-money-v4.ts', 'material-fact-range-review.ts'])
  await cp(resolve(PATCH, 'lib', name), resolve(temporary, 'lib', name));
const load = name => import(pathToFileURL(resolve(temporary, 'lib', name)).href);
const { normalizeMoneyValueV4: parse, normalizeCandidateValueV4: normalize } = await load('material-money-v4.ts');
const { attachedMoneyQualifierStatus } = await load('material-fact-range-review.ts');
const { emptyFactState, ingestCandidates, validateCandidateOutput } = await load('material-facts-v3.ts');
const { ingestRuntimeCandidates } = await load('material-fact-runtime-ingest.ts');
const { reviewFactsAgainstSources } = await load('material-fact-source-review.ts');
const cpLength = text => Array.from(text).length;
const AT = '2026-10-19T00:00:00.000Z';

function fixture(expression, { value = expression, fullQuote = false, rate = false, rateUnit = 'month', next = null, page = 1 } = {}) {
  const source = { id: 'round36-money', name: '合成上下界与月份分母', sha256: 'a'.repeat(64), analysisRevision: 36, ready: true,
    blocks: [{ id: 'b1', page: 1, text: '😀王甲工资' + expression + (next === null ? '。' : ''), bbox: null, confidence: null }] };
  if (next !== null) source.blocks.push({ id: 'b2', page, text: next, bbox: null, confidence: null });
  const candidate = { kind: 'money', value, quote: fullQuote ? source.blocks[0].text : value, blockId: 'b1', subject: '王甲', scope: 'individual',
    meaning: rate ? 'rate' : 'due_total', completeness: rate ? 'not_applicable' : 'complete',
    period: rate ? null : '2026年1月', rateUnit: rate ? rateUnit : null, assertion: 'narrated' };
  return { source, candidate, raw: JSON.stringify({ schemaVersion: 3, candidates: [candidate] }) };
}

function pipeline(f, wanted, wantedStatus = null) {
  const original = structuredClone(f);
  const schema = validateCandidateOutput(f.raw, f.source);
  assert.equal(schema.rejected.length, 0, 'fixture must satisfy the real candidate schema');
  const fresh = ingestRuntimeCandidates(emptyFactState(36), f.source, { raw: f.raw }, 'synthetic', 'round36-author', AT);
  const observations = [];
  function inspect(state, label, expected) {
    assert.equal(state.materials[0].candidates.length, 1, label + ': original observation retained');
    assert.equal(state.materials[0].raw, f.raw); assert.equal(state.materials[0].rejected.length, 0);
    assert.equal(state.calculation, null); assert.deepEqual(state.confirmations, { due: null, paid: null });
    const fact = state.materials[0].candidates[0], text = f.source.blocks[0].text;
    assert.equal(fact.amount, expected, label + ': amount'); assert.equal(fact.value, f.candidate.value); assert.equal(fact.quote, f.candidate.quote);
    assert.deepEqual(fact.representation, f.candidate);
    const start = cpLength(text.slice(0, text.indexOf(f.candidate.quote)));
    assert.deepEqual([fact.start, fact.end], [start, start + cpLength(f.candidate.quote)]);
    assert.equal(Array.from(text).slice(fact.start, fact.end).join(''), f.candidate.quote);
    if (expected === null) assert.notEqual(fact.normalization.status, 'exact');
    if (label !== 'stored-null' && wantedStatus) assert.equal(fact.normalization.status, wantedStatus, label + ': status');
    observations.push(fact);
  }
  inspect(fresh, 'fresh', wanted);
  for (const oldAmount of ['4000.00', null]) {
    const stored = ingestCandidates(emptyFactState(36), f.source, { raw: f.raw }, 'synthetic', 'round36-author', AT);
    const fact = stored.materials[0].candidates[0];
    fact.amount = oldAmount;
    fact.normalization = { rawValue: f.candidate.value, status: oldAmount === null ? 'unsupported' : 'exact', amount: oldAmount,
      matchedText: f.candidate.value, span: { start: 0, end: cpLength(f.candidate.value) }, reason: 'Unconfirmed synthetic persisted state.' };
    const before = structuredClone(stored), reviewed = reviewFactsAgainstSources(stored, [f.source]);
    assert.deepEqual(stored, before); assert.deepEqual(reviewed.history, before.history);
    inspect(reviewed, oldAmount === null ? 'stored-null' : 'stored-exact', oldAmount === null ? null : wanted);
  }
  assert.deepEqual(f, original); return observations;
}

for (const suffix of ['及以上', '或以下']) test('minimal bound is not an exact amount: ' + suffix, () => {
  const expression = '4000元' + suffix;
  assert.equal(parse(expression).amount, null); assert.equal(parse(expression).status, 'approximate');
  assert.equal(normalize(fixture(expression, { value: '4000元', fullQuote: true }).candidate).amount, null);
  pipeline(fixture(expression, { value: '4000元' }), null);
});
for (const suffix of ['每个月', '/個月']) test('minimal complete monthly classifier remains a declared month rate: ' + suffix, () => {
  const f = fixture('4000元' + suffix, { rate: true });
  assert.equal(normalize(f.candidate).amount, '4000.00'); pipeline(f, '4000.00');
});

if (!minimal) {
  for (const suffix of ['及以下', '或以上', '及\n以上', '或\u200d以下', '及 以上', '或 以下', '及以上工资', '或以下金额']) {
    test('finite conjunction bound shares full-value and clipped quote grammar: ' + JSON.stringify(suffix), () => {
      assert.equal(parse('4000元' + suffix).amount, null); assert.equal(attachedMoneyQualifierStatus('', suffix), 'approximate');
      for (const fullQuote of [false, true]) pipeline(fixture('4000元' + suffix, { value: '4000元', fullQuote }), null);
    });
  }
  for (const suffix of ['及以上。', '或以下。', '及\n以上。', '或\u200d以下。'])
    test('same-page adjacent source bound cannot disappear from a minimal quote: ' + JSON.stringify(suffix), () =>
      pipeline(fixture('4000元', { value: '4000元', next: suffix }), null));
  for (const suffix of ['及以上海银行卡支付', '或以下列方式支付', '及以上述方式支付', '或以下文约定支付', '及工资记录', '或另行支付'])
    test('ordinary continuation is not turned into a bound: ' + suffix, () => {
      assert.equal(parse('4000元' + suffix).amount, '4000.00');
      pipeline(fixture('4000元' + suffix, { value: '4000元', fullQuote: true }), '4000.00');
    });
  for (const suffix of ['及以上。', '或以下。'])
    test('page or sentence boundary does not attach a different amount bound: ' + suffix, () => {
      pipeline(fixture('4000元。', { value: '4000元', next: '王乙工资' + suffix }), '4000.00');
      pipeline(fixture('4000元', { value: '4000元', next: suffix, page: 2 }), '4000.00');
    });

  const monthly = ['每个月', '/个月', '每個月', '/個月', '每 个月', '/\n個月', '每\n个月', '/个\u200d月'];
  for (const suffix of monthly) {
    test('complete month alias retains a correct declared rate and raw span: ' + JSON.stringify(suffix), () => {
      assert.equal(parse('4000元' + suffix).amount, '4000.00');
      for (const fullQuote of [false, true]) pipeline(fixture('4000元' + suffix, { value: '4000元', fullQuote, rate: true }), '4000.00');
    });
    test('month alias cannot authorize a total or wrong enum: ' + JSON.stringify(suffix), () => {
      pipeline(fixture('4000元' + suffix, { value: '4000元' }), null, 'rate_unit_mismatch');
      pipeline(fixture('4000元' + suffix, { value: '4000元', rate: true, rateUnit: 'day' }), null, 'rate_unit_mismatch');
    });
  }
  for (const tail of ['待定', '？', '以上', '或以下', '美元', '人民币人民币'])
    test('supported monthly alias cannot hide an attached unsafe tail: ' + tail, () => {
      for (const suffix of ['每个月', '/個月']) {
        assert.equal(normalize(fixture('4000元' + suffix + tail, { rate: true }).candidate).amount, null);
        pipeline(fixture('4000元' + suffix + tail, { value: '4000元', rate: true }), null);
      }
    });
  for (const suffix of ['/个月亮', '/個月份', '每个月亮', '每個月份', '/月份', '/月亮', '/小时候', '每个季度'])
    test('a partial or unsupported denominator cannot borrow month: ' + suffix, () => {
      for (const rate of [false, true]) pipeline(fixture('4000元' + suffix, { value: '4000元', rate }), null);
    });
  for (const ending of ['整', '正'])
    test('complete amount ending preserves alias rate and unknown guards: ' + ending, () => {
      pipeline(fixture('4000元' + ending + '每个月', { value: '4000元', rate: true }), '4000.00');
      pipeline(fixture('4000元' + ending + '每個月？', { value: '4000元', rate: true }), null);
      pipeline(fixture('4000元' + ending + '/个月', { value: '4000元' }), null);
    });
  for (const suffix of ['/月', '每月', '/小时', '/小時', '/件'])
    test('existing supported rate remains available only for the correct enum: ' + suffix, () => {
      const rateUnit = /时|時/u.test(suffix) ? 'hour' : suffix === '/件' ? 'piece' : 'month';
      pipeline(fixture('4000元' + suffix, { value: '4000元', rate: true, rateUnit }), '4000.00');
      pipeline(fixture('4000元' + suffix, { value: '4000元' }), null);
    });
  test('bare next-row monthly prose retains the previous detached-row contract', () => {
    const facts = pipeline(fixture('4000元', { value: '4000元', next: '每月。' }), '4000.00');
    assert(facts[0].reviewIssues.some(issue => issue.code === 'source_relation_unresolved'));
  });
  for (const suffix of ['/\n个月。', '/\n個月。'])
    test('explicit slash joins an adjacent month alias while preserving declaration checks: ' + JSON.stringify(suffix), () => {
      const split = suffix.split('\n');
      pipeline(fixture('4000元' + split[0], { value: '4000元', next: split[1], rate: true }), '4000.00');
      pipeline(fixture('4000元' + split[0], { value: '4000元', next: split[1] }), null);
    });
}
