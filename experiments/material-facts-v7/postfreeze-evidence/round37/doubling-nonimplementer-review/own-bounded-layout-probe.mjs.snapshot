import assert from 'node:assert/strict';
import { pathToFileURL } from 'node:url';
const ROOT='/Users/xuzihan/Documents/Projects/国创/anxin-facts-v7-code-review';
const load=file=>import(pathToFileURL(ROOT+'/lib/'+file));
const {ingestRuntimeCandidates}=await load('material-fact-runtime-ingest.ts');
const {emptyFactState,buildFactView}=await load('material-facts-v3.ts');
const cases=[
 {name:'same-page direct doubling fragment',tail:'翻倍。',page:1,amount:null,usable:false},
 {name:'same-page finite wage noun doubling',tail:'工资加倍。',page:1,amount:null,usable:false},
 {name:'different-page must not assert arithmetic join',tail:'翻倍。',page:2,amount:'4000.00',usable:false},
 {name:'different named person cannot modify this amount',tail:'李乙工资翻倍。',page:1,amount:'4000.00',usable:false},
 {name:'sentence-boundary preserves base precision but leaves relationship review',tail:'李乙工资翻倍。',page:1,periodStop:true,amount:'4000.00',usable:false},
 {name:'complete single-owner control has usable candidate',tail:null,page:1,amount:'4000.00',usable:true},
];
for(const item of cases) for(const full of [false,true]){
 const first='😀王甲2026年1月全部应付工资合计4000元'+(item.tail&&!item.periodStop?'':'。');
 const blocks=[{id:'b1',page:1,text:first,bbox:null,confidence:null}];if(item.tail)blocks.push({id:'b2',page:item.page,text:item.tail,bbox:null,confidence:null});
 const source={id:'r37-boundary-review',name:'synthetic.txt',sha256:'b'.repeat(64),analysisRevision:37,ready:true,blocks};
 const representation={kind:'money',value:'4000元',quote:full?first:'4000元',blockId:'b1',subject:'王甲',scope:'individual',meaning:'due_total',completeness:'complete',period:'2026年1月',rateUnit:null,assertion:'narrated'};
 const raw=JSON.stringify({schemaVersion:3,candidates:[representation]});
 const state=ingestRuntimeCandidates(emptyFactState(37),source,{raw},'synthetic','reviewer','2026-10-19T19:00:00.000Z');
 const fact=state.materials[0].candidates[0];assert.equal(fact.amount,item.amount,item.name);assert.equal(state.materials[0].raw,raw);assert.deepEqual(fact.representation,representation);
 state.scope={worker:'王甲',employer:'甲公司',start:'2026-01-01',end:'2026-01-31'};state.scopeReview={note:'Synthetic existing scope',actor:'fixture',at:'2026-10-19T19:00:00.000Z'};
 const view=buildFactView(state,[source]);assert.deepEqual(view.fields.due.values,item.usable?['4000.00']:[],item.name);assert.equal(view.canCalculate,false);
 console.log(JSON.stringify({name:item.name,full,amount:fact.amount,status:fact.normalization.status,issues:fact.reviewIssues.map(i=>i.code),due_values:view.fields.due.values,raw_preserved:true}));
}
