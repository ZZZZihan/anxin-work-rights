// Real CLI subprocesses and kernel sockets; the Wrangler/service fixtures below
// are synthetic. This does not run an application build or a model.
import test from 'node:test';
import assert from 'node:assert/strict';
import { spawn, execFileSync } from 'node:child_process';
import { connect, createServer } from 'node:net';
import { mkdtemp, mkdir, readFile, writeFile, copyFile, rm } from 'node:fs/promises';
import { dirname, resolve, join } from 'node:path';
import { fileURLToPath } from 'node:url';
import { tmpdir } from 'node:os';

const ROOT = resolve(process.env.ANXIN_HTTP_REPEAT_SIGNAL_ROOT ?? resolve(dirname(fileURLToPath(import.meta.url)), '..'));
const pause = ms => new Promise(done => setTimeout(done, ms));
const alive = port => new Promise(done => {
  const socket = connect({ host: '127.0.0.1', port });
  socket.once('connect', () => { socket.destroy(); done(true); });
  socket.once('error', () => { socket.destroy(); done(false); });
});
// Observe a connection established with the original fixture process. A later
// listener can legitimately reuse its port while the TERM-ignoring descendant
// keeps group cleanup active; a fresh connect cannot identify the old owner.
async function observeSocket(port) {
  const socket = connect({ host: '127.0.0.1', port });
  const observed = { socket, closed: false };
  socket.once('close', () => { observed.closed = true; });
  await new Promise((done, reject) => { socket.once('connect', done); socket.once('error', reject); });
  return observed;
}
async function until(check, message, milliseconds = 8000) {
  const deadline = Date.now() + milliseconds;
  do { if (await check()) return; await pause(20); } while (Date.now() < deadline);
  assert.fail(message);
}
async function json(path) { try { return JSON.parse(await readFile(path, 'utf8')); } catch (error) { if (error.code === 'ENOENT') return; throw error; } }
function members(pgid) {
  return execFileSync('/bin/ps', ['-axo', 'pid=,pgid=,stat='], { encoding: 'utf8', timeout: 2000 }).trim().split('\n')
    .map(line => line.trim().split(/\s+/u)).filter(([, group, state]) => Number(group) === pgid && !/^[ZX]/iu.test(state));
}
function terminate(pid) {
  if (!pid) return;
  try { process.kill(-pid, 'SIGKILL'); } catch (error) { if (!['ESRCH', 'EPERM'].includes(error.code)) throw error; }
  // EPERM is not proof of success: the original owned groups are checked below.
}

const leaf = `import{createServer}from'node:net';import{writeFile,rename}from'node:fs/promises';
async function publish(path,value){const temporary=path+'.'+process.pid+'.tmp';await writeFile(temporary,value);await rename(temporary,path);}
if(process.argv[3]==='ignore')process.on('SIGTERM',()=>{});
const server=createServer(()=>{});server.listen(0,'127.0.0.1',async()=>{await publish(process.argv[2],JSON.stringify({pid:process.pid,port:server.address().port}));});`;
const wrangler = `import{createServer}from'node:http';import{spawn}from'node:child_process';import{mkdir,readFile,writeFile,rename}from'node:fs/promises';import{join}from'node:path';import{DatabaseSync}from'node:sqlite';
let markerSequence=0;async function publish(path,value){const temporary=path+'.'+process.pid+'.'+(++markerSequence)+'.tmp';await writeFile(temporary,value);await rename(temporary,path);}
const args=process.argv.slice(2),mode=process.env.ANXIN_INTERRUPT_FIXTURE_MODE,dir=process.env.ANXIN_INTERRUPT_FIXTURE_DIR;
const migration=args[0]==='d1';
if(migration&&!['migration','migration-failure'].includes(mode)){
 const state=args[args.indexOf('--persist-to')+1];await mkdir(state,{recursive:true});const db=new DatabaseSync(join(state,'fixture.sqlite'));db.exec('CREATE TABLE cases(id TEXT)');db.close();
}else{
 const stage=migration?'migration':'worker';
 spawn(process.execPath,[join(dir,'leaf.mjs'),join(dir,'owned-leaf.json'),'ignore'],{stdio:'ignore'});
 const port=migration?0:Number(args[args.indexOf('--port')+1]);
 const server=createServer(async(req,res)=>{
  if(req.url==='/api/bootstrap'&&mode==='pending'){res.writeHead(401);res.end('{}');return;}
  await publish(join(dir,'request.json'),JSON.stringify({path:req.url}));
  // Deliberately never complete startup or the first business HTTP request.
 });
 server.listen(port,'127.0.0.1',async()=>{
  await publish(join(dir,'owned.json'),JSON.stringify({stage,pid:process.pid,port:server.address().port,state:args[args.indexOf('--persist-to')+1]}));
  if(mode==='migration-failure'){
   // Establish that the redirected child installed its TERM handler before the
   // launcher fails; otherwise shutdown could correctly kill it before the test.
   for(;;){try{await readFile(join(dir,'owned-leaf.json'));break;}catch{await new Promise(done=>setTimeout(done,10));}}
   // The test must hold the original launcher connection before this deliberate
   // failure. This handshake adds no signal handler or shutdown behavior.
   for(;;){try{await readFile(join(dir,'observers-ready'));break;}catch{await new Promise(done=>setTimeout(done,10));}}
   process.exit(23);
  }
 });
}`;
const service = `import{createServer}from'node:http';
export async function createMaterialService(){const server=createServer((req,res)=>{res.end('{}');});await new Promise(done=>server.listen(0,'127.0.0.1',done));return{url:'http://127.0.0.1:'+server.address().port,async close(){server.closeAllConnections();await new Promise(done=>server.close(done));}};}`;

const scenarios = ['v7', 'recovery'].flatMap(runner => ['migration', 'migration-failure'].flatMap(mode =>
  ['SIGINT', 'SIGTERM'].map(firstSignal => ({ runner, mode, firstSignal }))));
scenarios.push({ runner: 'v7', mode: 'migration', firstSignal: 'SIGINT', reusePort: true });
for (const { runner, mode, firstSignal, reusePort = false } of scenarios) {
  test(`actual ${runner} CLI drains ${mode} after ${firstSignal} repeated during cleanup${reusePort ? ' with unrelated port reuse' : ''}`, { skip: process.platform === 'win32', timeout: 25000 }, async t => {
    const temp = await mkdtemp(join(tmpdir(), 'anxin-http-repeat-signal-'));
    let cli, sibling, childInfo, leafInfo, otherInfo, rebound;
    const originalConnections = [];
    const report = join(temp, 'report.json');
    let stdout = '', stderr = '';
    t.diagnostic(JSON.stringify({ node: process.version, runner, mode, firstSignal }));
    t.after(async () => {
      for (const observed of originalConnections) observed.socket.destroy();
      if (rebound) await new Promise(done => rebound.close(done));
      if (cli && cli.exitCode === null && cli.signalCode === null) cli.kill('SIGKILL');
      childInfo ??= await json(join(temp, 'owned.json'));
      leafInfo ??= await json(join(temp, 'owned-leaf.json'));
      otherInfo ??= await json(join(temp, 'unrelated.json'));
      terminate(childInfo?.pid); terminate(sibling?.pid);
      // A released port can already belong to another concurrent fixture. Never
      // treat that new listener as this test's resource or wait for it to stop.
      for (const pid of [childInfo?.pid, sibling?.pid].filter(Boolean)) await until(() => members(pid).length === 0, 'Test-owned process group survived emergency cleanup.');
      if (childInfo?.state) {
        const privateRoot = dirname(childInfo.state);
        assert(privateRoot.startsWith(tmpdir() + '/') && /anxin-fact(?:s-v7|-recovery)-http-[^/]+$/u.test(privateRoot));
        await rm(privateRoot, { recursive: true, force: true });
      }
      await rm(temp, { recursive: true, force: true });
    });
    await mkdir(join(temp, 'scripts'), { recursive: true });
    await mkdir(join(temp, 'node_modules/wrangler/bin'), { recursive: true });
    await mkdir(join(temp, 'dist/server'), { recursive: true });
    await writeFile(join(temp, 'package.json'), '{"type":"module"}');
    await writeFile(join(temp, 'node_modules/wrangler/package.json'), '{"type":"module"}');
    const script = runner === 'v7' ? 'material-facts-v7-http-regression.mjs' : 'material-facts-recovery-http-regression.mjs';
    await copyFile(join(ROOT, 'scripts', script), join(temp, 'scripts', script));
    await copyFile(join(process.env.ANXIN_HTTP_REPEAT_HELPER_ROOT || ROOT, 'scripts/owned-http-process-group.mjs'), join(temp, 'scripts/owned-http-process-group.mjs'));
    await writeFile(join(temp, 'scripts/material-service.mjs'), service);
    await writeFile(join(temp, 'node_modules/wrangler/bin/wrangler.js'), wrangler);
    await writeFile(join(temp, 'leaf.mjs'), leaf);
    await writeFile(join(temp, 'dist/server/wrangler.json'), '{"main":"noop.mjs","d1_databases":[]}');
    sibling = spawn(process.execPath, [join(temp, 'leaf.mjs'), join(temp, 'unrelated.json'), 'normal'], { detached: true, stdio: 'ignore' });
    cli = spawn(process.execPath, [join(temp, 'scripts', script), report], {
      cwd: temp, stdio: ['ignore', 'pipe', 'pipe'],
      env: { ...process.env, NODE_OPTIONS: '', ANXIN_INTERRUPT_FIXTURE_MODE: mode, ANXIN_INTERRUPT_FIXTURE_DIR: temp },
    });
    const closed = new Promise(done => cli.once('close', (code, signal) => done({ code, signal })));
    cli.stdout.on('data', chunk => { stdout += chunk; }); cli.stderr.on('data', chunk => { stderr += chunk; });
    await until(async () => {
      childInfo = await json(join(temp, 'owned.json')); leafInfo = await json(join(temp, 'owned-leaf.json')); otherInfo = await json(join(temp, 'unrelated.json'));
      if (cli.exitCode !== null || cli.signalCode !== null) assert.fail(`CLI exited before fixture barrier: ${stdout}\n${stderr}`);
      if (!childInfo || !leafInfo || !otherInfo) return false;
      if (['startup', 'pending'].includes(mode)) { const request = await json(join(temp, 'request.json')); if (!request || mode === 'pending' && request.path !== '/api/cases') return false; }
      return true;
    }, 'Actual CLI did not reach its native child/socket boundary.');
    assert.equal(await alive(leafInfo.port), true);
    const launcherConnection = await observeSocket(childInfo.port);
    originalConnections.push(launcherConnection);
    const descendantConnection = await observeSocket(leafInfo.port);
    originalConnections.push(descendantConnection);
    const unrelatedConnection = await observeSocket(otherInfo.port);
    originalConnections.push(unrelatedConnection);
    await writeFile(join(temp, 'observers-ready'), '', { flag: 'wx' });
    if (mode === 'migration-failure') {
      // The launcher has already failed. Its finally is stopping the redirected
      // TERM-ignoring child when the first interrupt arrives.
      await until(() => members(childInfo.pid).every(([pid]) => Number(pid) !== childInfo.pid), 'Migration leader did not exit before the cleanup interruption.');
    }
    cli.kill(firstSignal);
    if (reusePort) {
      await until(async () => !await alive(childInfo.port), 'Original launcher listener did not stop before controlled port reuse.', 2000);
      await until(() => launcherConnection.closed, 'The original listener connection must close before its port is reused.', 2000);
      assert.equal(descendantConnection.closed, false, 'The original TERM-ignoring descendant must still be active at controlled port reuse.');
      assert(members(childInfo.pid).some(([pid]) => Number(pid) === leafInfo.pid), 'The original descendant must still belong to its owned group during port reuse.');
      rebound = createServer(socket => socket.end('unrelated replacement listener'));
      await new Promise((done, reject) => { rebound.once('error', reject); rebound.listen(childInfo.port, '127.0.0.1', done); });
      t.diagnostic(JSON.stringify({ controlledPortReuse: true, originalLauncherPid: childInfo.pid, replacementPid: process.pid,
        replacementOutsideOriginalGroup: !members(childInfo.pid).some(([pid]) => Number(pid) === process.pid) }));
    }
    {
      // A redirected descendant ignores TERM, keeping cleanup active long enough
      // to deliver repeated real signals. They must not restore default exit.
      await pause(100); cli.kill(firstSignal); await pause(100); cli.kill(firstSignal);
    }
    let timer;
    const result = await Promise.race([closed, new Promise((_, reject) => { timer = setTimeout(() => reject(new Error('Interrupted CLI did not exit within its cleanup deadline.')), 16000); })]).finally(() => clearTimeout(timer));
    const sockets = { launcher: await alive(childInfo.port), descendant: await alive(leafInfo.port), unrelated: await alive(otherInfo.port) };
    const originalSockets = { launcher: !launcherConnection.closed, descendant: !descendantConnection.closed, unrelated: !unrelatedConnection.closed };
    t.diagnostic(JSON.stringify({ mode, exit: result, sockets, originalSockets, originalGroup: members(childInfo.pid) }));
    assert.equal(result.signal, null, `CLI bypassed finally on ${result.signal}; ${stderr}`);
    assert.equal(result.code, 1, 'An interrupted acceptance run must fail.');
    const recorded = await json(report);
    assert.equal(recorded?.status, 'FAIL', 'An interrupted run must replace its report with FAIL.');
    if (mode === 'migration-failure') {
      assert.match((recorded.failure ?? recorded.setupFailure).message, /migrations exited 23/u, 'The original migration failure must survive a cleanup-time signal.');
      assert(recorded.interruption, 'Cleanup interruption must be recorded alongside the earlier failure.');
    } else assert(recorded.interruption, 'The first interruption must survive report publication.');
    assert.equal(sockets.launcher, false, 'Original bare-port assertion: the detached launcher socket must be released before CLI exit.');
    assert.equal(originalSockets.descendant, false, 'The redirected descendant original socket must be released before CLI exit.');
    assert.deepEqual(members(childInfo.pid), [], 'No non-zombie owned group member may remain.');
    assert.equal(sockets.unrelated, true, 'An unrelated process group must remain alive.');
    assert.equal(originalSockets.unrelated, true, 'The preexisting unrelated connection must remain alive.');
    if (reusePort) {
      assert.equal(sockets.launcher, true, 'The controlled unrelated replacement must own the reused port.');
      assert.equal(rebound.listening, true, 'Cleanup must leave the unrelated replacement listener alive.');
    }
    t.diagnostic(JSON.stringify({ mode, cleanup: recorded.cleanup.status, cleanupOperations: recorded.cleanup.failures.map(item => item.operation) }));
    assert.deepEqual(recorded.cleanup, { status: 'PASS', failures: [] }, 'Successful owned-group cleanup must not hide a diagnostic failure.');
    await assert.rejects(readFile(join(dirname(childInfo.state), 'wrangler.json')), { code: 'ENOENT' }, 'Owned disposable configuration/state must be removed after confirmed cleanup.');
    assert.equal(recorded.interruption.signal, firstSignal);
    assert.equal(recorded.actualModelInference, false);
    assert.equal(recorded.syntheticInputs, true);
  });
}
