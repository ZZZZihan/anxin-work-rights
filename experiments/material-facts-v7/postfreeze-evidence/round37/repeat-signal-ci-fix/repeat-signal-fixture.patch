+// Observe a connection established with the original fixture process. A later
+// listener can legitimately reuse its port while the TERM-ignoring descendant
+// keeps group cleanup active; a fresh connect cannot identify the old owner.
+async function observeSocket(port) {
+  const socket = connect({ host: '127.0.0.1', port });
+  const observed = { socket, closed: false };
+  socket.once('close', () => { observed.closed = true; });
+  await new Promise((done, reject) => { socket.once('connect', done); socket.once('error', reject); });
+  return observed;
+}
