import assert from 'node:assert/strict';
import { createHash } from 'node:crypto';
import { access, cp, mkdir, mkdtemp, readFile, rm, writeFile } from 'node:fs/promises';
import { tmpdir } from 'node:os';
import { resolve } from 'node:path';
import { withCorrectionV26Code } from "file:///Users/xuzihan/Documents/Projects/%E5%9B%BD%E5%88%9B/anxin-facts-v7-money/.scratch/round37-v27-prepared/experiments/material-facts-v7/verify-correction-v26.mjs";
const PREPARED = "/Users/xuzihan/Documents/Projects/\u56fd\u521b/anxin-facts-v7-money/.scratch/round37-v27-prepared", E = 'experiments/material-facts-v7';
const sha = b => createHash('sha256').update(b).digest('hex');
const exists = async p => { try { await access(p); return true; } catch(e) { if(e.code==='ENOENT')return false;throw e; } };
const fixture = await mkdtemp(resolve(tmpdir(),'anxin-r37-nonimplementer-restore-'));
let restored, count=0;
try {
  for (const dir of ['lib','scripts','docs',`${E}/corrections-v26`]) await mkdir(resolve(fixture,dir),{recursive:true});
  await writeFile(resolve(fixture,'package.json'),'{}\n');
  await cp(resolve(PREPARED,E,'correction-code-v26'),resolve(fixture,E,'correction-code-v26'),{recursive:true});
  const original=await readFile(resolve(PREPARED,E,'corrections-v26/manifest.json'));
  const manifest=JSON.parse(original);
  await writeFile(resolve(fixture,E,'corrections-v26/manifest.json'),original);
  const liveChanged='// synthetic current drift, must be overwritten only in wrapper-owned temp\n';
  await writeFile(resolve(fixture,'lib/material-fact-event-review.ts'),liveChanged);
  const sentinel=new Error('nonimplementer exact callback sentinel');
  await assert.rejects(withCorrectionV26Code(async temporary=>{
    restored=temporary; assert.notEqual(temporary,fixture);
    for (const [path,digest] of Object.entries(manifest.code_sha256)) {
      assert.equal(sha(await readFile(resolve(temporary,path))),digest,path); count++;
    }
    assert.equal(count,97);
    throw sentinel;
  },fixture),error=>error===sentinel);
  assert(restored);assert.equal(await exists(restored),false);
  assert.equal(await readFile(resolve(fixture,'lib/material-fact-event-review.ts'),'utf8'),liveChanged);
  assert.deepEqual(await readFile(resolve(fixture,E,'corrections-v26/manifest.json')),original);
  console.log(JSON.stringify({status:'PASS',restored_exact_files:count,original_callback_error_identity_preserved:true,owned_restored_temp_removed:true,fixture_live_source_unchanged:true,actual_historical_cli:false,compute:false,model_requests:0}));
} finally { await rm(fixture,{recursive:true,force:true}); }
