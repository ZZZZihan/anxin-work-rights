+// A twenty-seventh, explicitly post-freeze assessment of the SAME original outputs.
+// Restore v26 before checking it with a narrow adapter. The immutable v1 policy
+// and older versioned bridges keep all children inside the same absolute deadline.
+import assert from 'node:assert/strict';
+import { publishArtifacts } from './publish-artifacts.mjs';
+import { runHistoricalV26CheckSync } from './historical-v26-execution.mjs';
+import { withCorrectionV26Code } from './verify-correction-v26.mjs';
+import { readFile, readdir } from 'node:fs/promises';
