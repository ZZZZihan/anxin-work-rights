    ],
    'files': inputs,
}
save('http447-readonly-review.independent.json', result)
print(json.dumps({'state': result['state'], 'before': '429P18F', 'after': '447P0F', 'raw_outputs': 448, 'restart_cases': 446, 'old_observations_unchanged': 427, 'source_files_unchanged': len(source_stability)}, ensure_ascii=False))
