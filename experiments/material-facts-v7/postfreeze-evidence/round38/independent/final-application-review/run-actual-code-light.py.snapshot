from pathlib import Path
import hashlib,json,subprocess,datetime,time
P=Path(__file__).resolve().parent
ROOT=Path('/Users/xuzihan/Documents/Projects/国创/anxin-facts-v7-code-review')
SCRIPT=Path('/Users/xuzihan/Documents/Projects/国创/anxin-facts-v7-review/scripts/material-facts-v7-round38-independent.test.mjs')
paths=['lib/material-money-v4.ts','lib/material-fact-range-review.ts','lib/material-fact-arithmetic-review.ts','lib/material-fact-event-review.ts','lib/material-fact-runtime-ingest.ts','lib/material-fact-source-review.ts','lib/material-facts-v3.ts']
sha=lambda b:hashlib.sha256(b).hexdigest()
def snapshot():return [{'path':x,'sha256':sha((ROOT/x).read_bytes()),'bytes':(ROOT/x).stat().st_size}for x in paths]
before=snapshot()
(P/'source-before.json').write_text(json.dumps(before,indent=2)+'\n')
import os
rows=[]
for name,node in [('node24','/Users/xuzihan/.npm/_npx/387698761821791d/node_modules/node/bin/node'),('node26','/opt/homebrew/bin/node')]:
 version=subprocess.run([node,'--version'],capture_output=True,text=True,check=True).stdout.strip()
 t=time.monotonic(); r=subprocess.run([node,'--test',str(SCRIPT)],env={**os.environ,'V7_REVIEW_ROOT':str(ROOT)},capture_output=True,timeout=60)
 (P/(name+'.stdout.log')).write_bytes(r.stdout);(P/(name+'.stderr.log')).write_bytes(r.stderr)
 row={'node':version,'node_path':node,'exit_code':r.returncode,'duration_seconds':time.monotonic()-t,'script_sha256':sha(SCRIPT.read_bytes()),'source_root':str(ROOT),'stdout_sha256':sha(r.stdout),'stderr_sha256':sha(r.stderr)}
 (P/(name+'.execution.json')).write_text(json.dumps(row,indent=2)+'\n');rows.append(row)
 print(json.dumps(row),flush=True)
after=snapshot();(P/'source-after.json').write_text(json.dumps(after,indent=2)+'\n')
assert before==after,'Protected source changed during check'
assert all(x['exit_code']==0 for x in rows),'Actual independent test failed; preserve logs and investigate'
print(json.dumps({'executions':2,'protected_files_unchanged':len(after)}))
