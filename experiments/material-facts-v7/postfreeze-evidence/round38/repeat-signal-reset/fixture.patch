+test('replacement listener accepts the readiness client resetting its connection', { timeout: 5000 }, async t => {
+  let peer, client;
+  const errors = [];
+  const server = createServer(socket => {
+    peer = socket;
+    socket.on('error', error => errors.push(error.code));
+    endReplacementConnection(socket);
+  });
+  t.after(async () => {
+    client?.destroy(); peer?.destroy();
+    await new Promise(done => server.close(done));
+  });
+  await new Promise((done, reject) => { server.once('error', reject); server.listen(0, '127.0.0.1', done); });
+  client = connect({ host: '127.0.0.1', port: server.address().port });
+  await new Promise((done, reject) => {
+    client.once('error', reject);
+    client.once('data', () => { client.resetAndDestroy(); done(); });
+  });
+  await until(() => errors.length !== 0, 'The controlled native reset did not reach the replacement listener.', 2000);
+  assert.deepEqual(errors, ['ECONNRESET']);
+  assert.equal(server.listening, true, 'A reset readiness connection must not stop the unrelated replacement listener.');
+});
+
+test('replacement listener does not suppress unexpected socket errors', () => {
+  // This is only the error propagation contract; the preceding test uses a real
+  // kernel TCP reset rather than emitting a synthetic ECONNRESET.
+  const socket = new EventEmitter();
+  socket.end = () => {};
+  endReplacementConnection(socket);
+  const unexpected = Object.assign(new Error('unexpected fixture socket failure'), { code: 'EPIPE' });
+  assert.throws(() => socket.emit('error', unexpected), error => error === unexpected);
+});
