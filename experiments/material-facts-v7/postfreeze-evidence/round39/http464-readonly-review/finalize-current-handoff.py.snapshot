from pathlib import Path
import datetime
import hashlib
import json
import re

P = Path(__file__).resolve().parent
OWN = P.parents[1]
CODE = Path('/Users/xuzihan/Documents/Projects/国创/anxin-facts-v7-code-review')
sha = lambda data: hashlib.sha256(data).hexdigest()


def save(path, data):
    with path.open('xb') as stream:
        stream.write(data if isinstance(data, bytes) else data.encode())


def save_json(path, data):
    save(path, json.dumps(data, ensure_ascii=False, indent=2) + '\n')


q = P / 'collective-default-path-closure'
receipt_path = CODE / '.scratch/issue42/round39/full-check.receipt.json'
receipt = json.loads(receipt_path.read_text())
save(q / 'parent-full-check-before-path-fix.receipt.json', receipt_path.read_bytes())
assert receipt['exitCode'] == 1
for key, expected in receipt['logs'].items():
    source = CODE / key
    value = source.read_bytes()
    assert sha(value) == expected
    save(q / ('parent-before-path-fix-' + source.name), value)
out = (q / 'parent-before-path-fix-full-check.stdout.log').read_text()
assert "Cannot find module '/Users/xuzihan/Documents/Projects/%E5%9B%BD%E5%88%9B/anxin-facts-v7-code-review/lib/material-fact-runtime-ingest.ts'" in out
counts = {key: int(re.search(rf'^ℹ {key} (\d+)\s*$', out, re.M).group(1)) for key in ['tests', 'pass', 'fail', 'skipped']}
assert counts == {'tests': 9486, 'pass': 9484, 'fail': 1, 'skipped': 1}
save_json(q / 'preserved-parent-full-failure.json', {'receipt_source': str(receipt_path), 'exit': receipt['exitCode'],
    'durationSeconds': receipt['durationSeconds'], 'runtime_counts_include_module_load_failure': counts,
    'failure': 'URL.pathname double-encodes a Chinese directory when subsequently passed to pathToFileURL.',
    'business_assertions_in_this_module_executed_before_failure': 0,
    'reviewer_ran_parent_full_check': False,
    'all_original_parent_logs_copied_and_digest_matched': True})
