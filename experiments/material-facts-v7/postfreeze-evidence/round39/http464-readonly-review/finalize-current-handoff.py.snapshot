def index(directory, name):
    rows = []
    for path in sorted(directory.iterdir()):
        if not path.is_file() or path.name == name:
            continue
        data = path.read_bytes()
        relative = Path('experiments/material-facts-v7') / path.relative_to(OWN)
        destination = str(relative) + ('.snapshot' if path.suffix in {'.py', '.mjs', '.ts'} else '')
        rows.append({'source': str(path), 'destination': destination, 'bytes': len(data), 'sha256': sha(data)})
    target = directory / name
    save_json(target, {'self_excluded': True, 'files': rows})
    return {'path': str(target), 'sha256': sha(target.read_bytes()), 'files': len(rows)}


indexes = [index(q, 'copy-index.default-path-closure.json'), index(h, 'copy-index.http464-readonly.json')]
save_json(P / 'current-handoff-indexes.json', {'observed_at': datetime.datetime.now(datetime.timezone.utc).isoformat(),
                                           'indexes': indexes})
print(json.dumps(indexes, ensure_ascii=False))
