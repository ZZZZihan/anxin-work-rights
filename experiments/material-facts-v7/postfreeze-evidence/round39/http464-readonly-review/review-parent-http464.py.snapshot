assert collections.Counter(row['status'] for row in b['observations']) == {'PASS': 464}
assert [row['name'] for row in a['observations']] == [row['name'] for row in b['observations']]
assert len({row['name'] for row in b['observations']}) == 464


def strip(values):
    return [{key: value for key, value in row.items() if key not in {'evidenceId', 'jobId'}} for row in values]


ao, bo = a['syntheticOutputs'], b['syntheticOutputs']
assert len(ao) == len(bo) == 465
assert strip(ao) == strip(bo)
assert all(list(row) == ['evidenceId', 'jobId', 'raw', 'candidates', 'finish_reason'] for row in ao + bo)
assert all(left['raw'].encode() == right['raw'].encode() for left, right in zip(ao, bo))
decoder = json.JSONDecoder()


def skip(text, position):
    while position < len(text) and text[position].isspace():
        position += 1
    return position


def output_value_slices(path):
    text = path.read_text()
    marker = '\n  "syntheticOutputs": ['
    assert text.count(marker) == 1
    position = text.index(marker) + len(marker)
    rows = []
    while True:
        position = skip(text, position)
        if text[position] == ']':
            return rows
        assert text[position] == '{'
        position += 1
        values = []
        while True:
            position = skip(text, position)
            if text[position] == '}':
                position += 1
                break
            key, position = decoder.raw_decode(text, position)
            position = skip(text, position)
            assert text[position] == ':'
            start = skip(text, position + 1)
            _, position = decoder.raw_decode(text, start)
            if key not in {'evidenceId', 'jobId'}:
                values.append((key, text[start:position].encode()))
            position = skip(text, position)
            if text[position] == ',':
                position += 1
        rows.append(values)
        position = skip(text, position)
        if text[position] == ',':
            position += 1


verbatim_before, verbatim_after = output_value_slices(a_path), output_value_slices(b_path)
assert len(verbatim_before) == len(verbatim_after) == 465
assert verbatim_before == verbatim_after
