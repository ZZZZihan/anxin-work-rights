from pathlib import Path
import collections
import datetime
import hashlib
import json
import subprocess

P = Path(__file__).resolve().parent
OWN = P.parents[2]
CODE = Path('/Users/xuzihan/Documents/Projects/国创/anxin-facts-v7-code-review')
R = CODE / '.scratch/issue42/round39'
BASE = '66581e78f695cf4ed70e9b1bde2f1456814f8b05'
digest = lambda data: hashlib.sha256(data).hexdigest()


def save(name, value):
    data = value if isinstance(value, bytes) else (json.dumps(value, ensure_ascii=False, indent=2) + '\n').encode()
    with (P / name).open('xb') as stream:
        stream.write(data)


inputs = []


def copy(source, name):
    data = source.read_bytes()
    save(name, data)
    inputs.append({'source': str(source), 'file': name, 'bytes': len(data), 'sha256': digest(data)})


products_before = {str(path.relative_to(CODE)): digest(path.read_bytes()) for path in sorted((CODE / 'lib').glob('*.ts'))}
for stem in ['http464-before-valid-runner', 'http464-after']:
    for suffix in ['json', 'receipt.json', 'stdout.log', 'stderr.log']:
        copy(R / f'{stem}.{suffix}', f'parent-{stem}.{suffix}')
for name in ['http464-before.receipt.json', 'http464-before.stdout.log', 'http464-before.stderr.log', 'http464-initial-runner.snapshot']:
    copy(R / name, f'preserved-initial-{name}')
for suffix in ['receipt.json', 'stdout.log', 'stderr.log']:
