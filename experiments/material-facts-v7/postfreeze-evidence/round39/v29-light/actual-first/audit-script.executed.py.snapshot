"""Independent saved-JSON arithmetic and byte audit. No production imports/CLI.

Do not execute until the parent publishes v29 and supplies its manifest digest.
The audit writes only to a new OWN output directory, never the reviewed ROOT.
"""
import argparse
import collections
import datetime
import hashlib
import json
import math
from pathlib import Path
import re
import time


HERE = Path(__file__).resolve().parent
LAYERS = [f"{scope}_{mode}" for scope in ("raw", "accepted") for mode in ("basic", "relational", "strict")]
BACKENDS = ("rules", "qwen", "deepseek")


def digest(data):
    return hashlib.sha256(data).hexdigest()


def changes(a, b, path=""):
    if type(a) is not type(b):
        return [{"path": path, "before": a, "after": b}]
    if isinstance(a, dict):
        return [item for key in sorted(set(a) | set(b))
                for item in changes(a.get(key), b.get(key), path + "/" + str(key))]
    if isinstance(a, list):
        if len(a) != len(b):
            return [{"path": path, "before": a, "after": b}]
        return [item for index, pair in enumerate(zip(a, b))
                for item in changes(*pair, path + "/" + str(index))]
    return [] if a == b else [{"path": path, "before": a, "after": b}]


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--root", required=True)
    parser.add_argument("--manifest-sha", required=True)
    parser.add_argument("--output-dir", required=True)
    parser.add_argument("--parent-protected-json", required=True, help="Parent-owned pre-v29 protected file list under reviewed ROOT")
    parser.add_argument("--execute-authorized-readonly-audit", action="store_true", required=True)
    args = parser.parse_args()
    assert re.fullmatch(r"[0-9a-f]{64}", args.manifest_sha)
    root, output = Path(args.root).resolve(), Path(args.output_dir).resolve()
    assert not output.is_relative_to(root), "Never write into reviewed ROOT"
    output.mkdir(parents=True, exist_ok=False)
    started = time.monotonic()
    base = root / "experiments/material-facts-v7"
    captured = json.loads((HERE / "trusted-baseline.v28.json").read_bytes())
    observed = {}

    def read_bytes(path, expected=None):
        path = path.resolve()
        assert path.is_relative_to(root), path
        data = path.read_bytes()
        actual = digest(data)
        if expected is not None:
            assert actual == expected, (str(path), expected, actual)
        key = str(path.relative_to(root))
        if key in observed:
            assert observed[key] == actual, ("Changed while read", key)
        observed[key] = actual
        return data

    def read(path, expected=None):
        return json.loads(read_bytes(path, expected))

    def jsonl(path):
        return [json.loads(line) for line in read_bytes(path).decode().splitlines() if line.strip()]

    def save(name, value):
        with (output / name).open("x") as file:
            json.dump(value, file, ensure_ascii=False, indent=2)
            file.write("\n")

    try:
        parent_snapshot_path = Path(args.parent_protected_json)
        if not parent_snapshot_path.is_absolute():
            parent_snapshot_path = root / parent_snapshot_path
        parent_snapshot = read(parent_snapshot_path, captured["parent_protection"]["sha256"])
        parent_rows = parent_snapshot["protected"]
        assert len(parent_rows) == captured["parent_protection"]["count"] == 1967
        assert len({row["path"] for row in parent_rows}) == len(parent_rows)
        for row in parent_rows:
            relative = Path(row["path"])
            assert not relative.is_absolute() and all(part not in ("", ".", "..") for part in relative.parts)
            assert re.fullmatch(r"[0-9a-f]{64}", row["sha256"])
            read_bytes(root / relative, row["sha256"])
        for relative, expected in captured["manifest_sha256"].items():
            read_bytes(base / relative, expected)
        freeze = read(base / "freeze.json")
        original = read(base / "result-manifest.json")
        assert len(freeze["files"]) == 124 and len(original["files"]) == 60
        frozen_archive_base = base / "frozen-code-v2"
        frozen_archive = read(frozen_archive_base / "manifest.json")
        assert frozen_archive["freeze_sha256"] == captured["manifest_sha256"]["freeze.json"]
        assert len(frozen_archive["files"]) == 36
        assert set(frozen_archive["files"]) <= set(freeze["files"])
        resolved_freeze = {}
        for relative, expected in freeze["files"].items():
            if relative in frozen_archive["files"]:
                assert frozen_archive["files"][relative] == expected
                path = frozen_archive_base / (relative + ".snapshot")
            else:
                path = root / relative
            read_bytes(path, expected)
            resolved_freeze[relative] = str(path.relative_to(root))
        for relative, expected in original["files"].items():
            read_bytes(base / relative, expected)
        # Previous saved reports/manifests, including all failed developer runs
        # bound by the original freeze/result manifests, remain byte evidence.
        for version in range(1, 29):
            directory = base / ("corrections" if version == 1 else f"corrections-v{version}")
            for relative, expected in read(directory / "manifest.json")["files"].items():
                read_bytes(directory / relative, expected)

        prior = read(base / "corrections-v28/manifest.json")
        manifest = read(base / "corrections-v29/manifest.json", args.manifest_sha)
        assert manifest["schema"] == "material-facts-v7-postfreeze-correction-manifest/29"
        assert manifest["previous_correction_manifest_sha256"] == captured["manifest_sha256"]["corrections-v28/manifest.json"]
        assert manifest["freeze_sha256"] == captured["manifest_sha256"]["freeze.json"]
        assert manifest["first_result_manifest_sha256"] == captured["manifest_sha256"]["result-manifest.json"]
        assert manifest["inference"] is False and manifest["training"] is False
        assert len(manifest["code_sha256"]) == 106 and len(prior["code_sha256"]) == 103
        assert set(prior["code_sha256"]) <= set(manifest["code_sha256"])
        assert set(manifest["code_sha256"]) - set(prior["code_sha256"]) == {
            "experiments/material-facts-v7/historical-v28-execution.mjs",
            "experiments/material-facts-v7/verify-correction-v28.mjs",
            "experiments/material-facts-v7/corrective-assessment-v29.mjs"}
        for relative, expected in manifest["code_sha256"].items():
            read_bytes(root / relative, expected)
        archive_base = base / "correction-code-v28"
        archive = read(archive_base / "manifest.json", captured["expected_archive_v28_manifest_sha256"])
        assert archive["schema"] == "material-facts-v7-correction-code/28"
        assert archive["correction_manifest_sha256"] == captured["manifest_sha256"]["corrections-v28/manifest.json"]
        assert archive["files"] == prior["code_sha256"]
        assert {str(p.relative_to(archive_base)) for p in archive_base.rglob("*.snapshot")} == {
            relative + ".snapshot" for relative in archive["files"]}
        for relative, expected in archive["files"].items():
            read_bytes(archive_base / (relative + ".snapshot"), expected)
        directory = base / "corrections-v29"
        assert {p.name for p in directory.iterdir()} == set(manifest["files"]) | {"manifest.json"}
        for relative, expected in manifest["files"].items():
            read_bytes(directory / relative, expected)
        for key, relative in (("input_sha256", "data/holdout.inputs.jsonl"),
                              ("labels_sha256", "data/holdout.labels.provisional.jsonl")):
            read_bytes(base / relative, manifest[key])
            assert manifest[key] == prior[key]
        labels = {row["id"]: row for row in jsonl(base / "data/holdout.labels.provisional.jsonl")}
        inputs = {row["id"]: row for row in jsonl(base / "data/holdout.inputs.jsonl")}
        assert len(labels) == len(inputs) == 12 and set(labels) == set(inputs)
        assert sum(len(row["expected"]) for row in labels.values()) == 43
        anchors = 0
        for case_id, label in labels.items():
            assert label["label_status"] == "provisional_non_expert"
            blocks = {b["id"]: b["text"] for b in inputs[case_id]["source"]["blocks"]}
            events = {event["id"]: event for event in label["events"]}
            assert len(events) == len(label["events"])
            assert len(label["expected_event_ids"]) == len(label["expected"])
            assert set(label["expected_event_ids"]) <= set(events)
            for event in events.values():
                assert event["anchors"]
                for anchor in event["anchors"]:
                    text = blocks[anchor["blockId"]]
                    assert 0 <= anchor["start"] < anchor["end"] <= len(text)
                    assert text[anchor["start"]:anchor["end"]]
                    anchors += 1
        assert anchors == 41
        comparison = read(directory / "comparison.json")
        prior_comparison = read(base / "corrections-v28/comparison.json")
        assert comparison["schema"] == "material-facts-v7-postfreeze-correction/29"
        assert comparison["inference"] is False and comparison["new_holdout_run"] is False
        assert comparison["labels"] == "unchanged_provisional_non_expert"
        assert comparison["planned_per_backend"] == 12 and comparison["expected_facts"] == 43
        summary, totals, money_totals = {}, collections.Counter(), collections.Counter()
        partitions = 0
        for backend in BACKENDS:
            prior_report = read(base / f"corrections-v28/report-{backend}.json")
            report = read(directory / f"report-{backend}.json")
            first = read(base / f"results/holdout-{backend}-1/report.json")
            for key, relative in (("raw_sha256", "results.jsonl"), ("first_report_sha256", "report.json")):
                assert manifest["evidence"][backend][key] == prior["evidence"][backend][key]
                read_bytes(base / f"results/holdout-{backend}-1/{relative}", manifest["evidence"][backend][key])
            saved = jsonl(base / f"results/holdout-{backend}-1/results.jsonl")
            assert len(saved) == 12 and {row["id"] for row in saved} == set(labels)
            assert all(row["finish_reason"] == "stop" for row in saved)
            raw = {}
            for row in saved:
                text = row["raw_output"].strip()
                if text.startswith("```"):
                    lines = text.splitlines()
                    assert lines[0].strip() in ("```", "```json") and lines[-1].strip() == "```"
                    text = "\n".join(lines[1:-1])
                parsed = json.loads(text)
                assert parsed["schemaVersion"] == 3 and isinstance(parsed["candidates"], list)
                raw[row["id"]] = parsed["candidates"]
            assert report["planned_documents"] == 12 and report["expected_facts"] == 43
            assert len(report["cases"]) == 12 and {case["id"] for case in report["cases"]} == set(labels)
            recounted = {layer: collections.Counter(tp=0, fp=0, fn=0) for layer in LAYERS}
            defense = collections.Counter()
            for case in report["cases"]:
                raw_candidates = raw[case["id"]]
                assert case["raw_count"] == len(raw_candidates)
                rejected = [row["index"] for row in case["rejected"]]
                assert len(set(rejected)) == len(rejected)
                assert all(0 <= index < len(raw_candidates) for index in rejected)
                accepted_indices = [index for index in range(len(raw_candidates)) if index not in rejected]
                assert len(accepted_indices) == case["accepted_count"] == len(case["production_defense"])
                for layer in LAYERS:
                    row = case[layer]
                    expected_indices = [pair["expected"] for pair in row["pairs"]]
                    actual_indices = [pair["actual"] for pair in row["pairs"]]
                    assert sorted(expected_indices + row["missing"]) == list(range(len(labels[case["id"]]["expected"])))
                    scope = layer.split("_")[0]
                    count = case["raw_count"] if scope == "raw" else case["accepted_count"]
                    assert sorted(actual_indices + row["extra"]) == list(range(count))
                    assert len(set(expected_indices)) == len(expected_indices) and len(set(actual_indices)) == len(actual_indices)
                    assert len(case["event_alignment"][scope]) == count
                    for pair in row["pairs"]:
                        event = labels[case["id"]]["expected_event_ids"][pair["expected"]]
                        assert pair["event"] == event == case["event_alignment"][scope][pair["actual"]]["event"]
                    values = dict(tp=len(row["pairs"]), fp=len(row["extra"]), fn=len(row["missing"]))
                    assert all(row[key] == value for key, value in values.items())
                    recounted[layer].update(values)
                    partitions += 1
                for index, row in enumerate(case["production_defense"]):
                    assert row["index"] == index
                    assert row["kind"] == raw_candidates[accepted_indices[index]]["kind"]
                    assert row["calculation_authorized"] is False
                    if row["kind"] != "money":
                        continue
                    defense["accepted_money"] += 1
                    defense["normalization:" + row["normalization"]] += 1
                    defense["amount_nonnull"] += row["amount"] is not None
                    defense["source_relation_unresolved"] += "source_relation_unresolved" in row["issues"]
                    defense["exact_without_issue"] += row["exact_money_without_review_issue"]
                totals.update(raw=case["raw_count"], accepted=case["accepted_count"], rejected=len(rejected))
            for layer, values in recounted.items():
                tp, fp, fn = (values[key] for key in ("tp", "fp", "fn"))
                assert tp + fn == 43
                values["precision"] = tp / (tp + fp) if tp + fp else None
                values["recall"] = tp / (tp + fn) if tp + fn else None
                values["f1"] = 2 * tp / (2 * tp + fp + fn) if 2 * tp + fp + fn else None
                for key, value in values.items():
                    for actual in (report["metrics"][layer][key], comparison["models"][backend]["corrected_metrics"][layer][key]):
                        assert actual is None if value is None else math.isclose(actual, value, rel_tol=1e-12, abs_tol=1e-12)
            for key, field in (("raw", "raw_candidates"), ("accepted", "accepted_candidates"), ("rejected", "rejected_candidates")):
                count = sum(case["raw_count"] if key == "raw" else case["accepted_count"] if key == "accepted" else len(case["rejected"]) for case in report["cases"])
                assert report[field] == comparison["models"][backend][field] == count
            money_totals.update(defense)
            summary[backend] = {"raw": report["raw_candidates"], "accepted": report["accepted_candidates"], "rejected": report["rejected_candidates"],
                "metrics_recounted": recounted, "metrics_equal_v28": report["metrics"] == prior_report["metrics"],
                "report_bytes_equal_v28": digest(read_bytes(directory / f"report-{backend}.json")) == digest(read_bytes(base / f"corrections-v28/report-{backend}.json")),
                "full_saved_report_changes_from_v28": changes(prior_report, report), "defense_counts": defense,
                "first_report_metrics": first["metrics"]}
        assert partitions == 216 and totals == {"raw": 116, "accepted": 104, "rejected": 12}
        assert money_totals["accepted_money"] == 46
        assert money_totals["source_relation_unresolved"] == 46 and money_totals["exact_without_issue"] == 0
        # Counts are observed, not assumed equal to v28's 19/25/2 distribution.
        after = {relative: digest((root / relative).read_bytes()) for relative in observed}
        assert observed == after, "Read-only audit observed a concurrent byte change"
        save("protected.before.json", observed)
        save("protected.after.json", after)
        result = {"schema": "round39-v29-light-independent/1", "status": "PASS", "audited_utc": datetime.datetime.now(datetime.timezone.utc).isoformat(),
            "manifest_sha256": args.manifest_sha, "root": str(root), "elapsed_seconds": time.monotonic() - started,
            "counts": {"holdout": 12, "gold": 43, "gold_anchor_spans": anchors, "saved_match_partitions": partitions,
                "aggregate_metrics": 18, "raw": totals["raw"], "accepted": totals["accepted"], "rejected": totals["rejected"],
                "current_code": 106, "archive_v28_code": 103, "original_results": 60, "original_freeze_paths": 124,
                "original_code_v2_snapshots": 36, "parent_prewrite_protected_paths": len(parent_rows), "protected_read_paths": len(observed)},
            "parent_protection": {"path": str(parent_snapshot_path.resolve()), **captured["parent_protection"]},
            "money_counts": money_totals, "models": summary, "comparison_models_changes_from_v28": changes(prior_comparison["models"], comparison["models"]),
            "original_freeze_resolution": resolved_freeze, "protected_unchanged": True,
            "role": "Data/selected runtime helper author; independent recount of saved JSON arithmetic and immutable byte bindings, not independent product implementation or source-semantic rematching.",
            "limits": ["Saved pairs/partitions are checked for disjointness, denominators and declared event consistency; no new matching algorithm is executed.",
                "All original124 bindings use36 frozen snapshots plus88 unchanged live paths; changed live code is not compared against obsolete original hashes.",
                "The parent-owned prewrite list is independently rehashed for all1967 rows and its own trusted SHA is checked; this includes all frozen input/gold/original-result bindings and prior saved correction archives.",
                "No historical CLI, scorer import, model, HTTP, build, full check, legal opinion or human business acceptance.",
                "calculation_authorized=false is a saved report diagnostic, not a production confirmation authorization."],
            "model_request": "gpt-6.1-sol / ultra; actual backend not independently verifiable"}
        save("audit.receipt.json", result)
        print(json.dumps({"status": "PASS", "counts": result["counts"], "money_counts": money_totals}, ensure_ascii=False, indent=2))
    except Exception as error:
        save("audit.failure.json", {"status": "FAIL", "type": type(error).__name__, "message": str(error),
            "elapsed_seconds": time.monotonic() - started, "read_paths_so_far": observed})
        raise


if __name__ == "__main__":
    main()
