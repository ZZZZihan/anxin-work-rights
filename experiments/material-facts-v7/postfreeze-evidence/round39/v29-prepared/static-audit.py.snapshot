refs={'ORIGINAL':e/'result-manifest.json','V27':e/'corrections-v27/manifest.json','V28':e/'corrections-v28/manifest.json','V9_BRIDGE':e/'historical-v9-execution.mjs','V27_BRIDGE':e/'historical-v27-execution.mjs','POLICY':e/'historical-execution-policy-v1.mjs','ADAPTER':e/'historical-execution-v1.mjs'}
constants=[]
for path in p['files']:
 s=(prep/path).read_text()
 for name,h in re.findall(r"const ([A-Z0-9_]+) = '([0-9a-f]{64})';",s):
  assert name in refs,(path,name);assert h==sha((root/refs[name]).read_bytes()),(path,name);constants.append({'file':path,'constant':name,'sha256':h,'source':str(refs[name])})
for name,last in [('scripts/material-facts-v7-correction-v28-gates-independent.test.mjs',28),('scripts/material-facts-v7-correction-v29-gates-independent.test.mjs',29)]:
 s=(prep/name).read_text();m=re.search(r'\.\.\.\[([^]]+)\]\.map',s);assert [int(n.strip()) for n in m[1].split(',')]==list(range(2,last+1));assert 'restores all 103' in s or last==28
union=set(v28['code_sha256'])|{str(e/'historical-v28-execution.mjs'),str(e/'verify-correction-v28.mjs'),str(e/'corrective-assessment-v29.mjs')};assert len(union)==106
b=json.loads((ev/'protected-root-before.json').read_bytes());changed=[path for path,h in b.items() if sha((root/path).read_bytes())!=h];assert not changed,changed
result={'status':'PASS','archive_paths':103,'snapshot_files_plus_manifest':104,'expected_current_union':106,'named_constant_hash_bindings':constants,'old_policy_bridges_unchanged':oldbridge_names,'root_budget_ms':900000,'cleanup_reserve_ms':2000,'protected_root_paths_unchanged':len(b),'version_arrays':'2..28 and 2..29 complete','controller_current_compute_calls':1,'actual_historical_cli_executed':False,'write_check_executed':False,'currentgate_executed':False,'model_requests':0};(ev/'static-audit.json').write_text(json.dumps(result,indent=2)+'\n');print(json.dumps({k:v for k,v in result.items() if k not in ['named_constant_hash_bindings','old_policy_bridges_unchanged']}))
