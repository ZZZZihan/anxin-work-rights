sha=lambda b:hashlib.sha256(b).hexdigest();p=json.loads((ev/'preparation.json').read_bytes());a=json.loads((prep/e/'correction-code-v28/manifest.json').read_bytes());v28=json.loads((prep/e/'corrections-v28/manifest.json').read_bytes());assert a['files']==v28['code_sha256'];assert len(a['files'])==103
