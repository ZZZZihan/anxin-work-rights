+++ b/scripts/material-facts-v7-round40-date-author.test.mjs
@@ -0,0 +1,92 @@
+// R40 two date envelopes only; no scorer, HTTP, model, or invented calendar year.
+import test, { after } from 'node:test';
+import assert from 'node:assert/strict';
+import { cp, mkdtemp, readFile, rm } from 'node:fs/promises';
+import { createHash } from 'node:crypto';
+import { tmpdir } from 'node:os';
+import { resolve } from 'node:path';
+import { fileURLToPath, pathToFileURL } from 'node:url';
+
+const ROOT = resolve(process.env.MATERIAL_FACT_TEST_ROOT || fileURLToPath(new URL('../', import.meta.url)));
+const EVENT = resolve(process.env.MATERIAL_FACT_EVENT_FILE || resolve(ROOT, 'lib/material-fact-event-review.ts'));
+const temporary = await mkdtemp(resolve(tmpdir(), 'anxin-r40-date-'));
+after(() => rm(temporary, { recursive: true, force: true }));
+await cp(resolve(ROOT, 'lib'), resolve(temporary, 'lib'), { recursive: true });
+await cp(EVENT, resolve(temporary, 'lib/material-fact-event-review.ts'));
+const load = name => import(pathToFileURL(resolve(temporary, 'lib', name)).href);
+const { hasSupportedCandidateAttribution: attributed } = await load('material-fact-event-review.ts');
+const { normalizeCandidateValue, emptyFactState, ingestCandidates: legacy, validateCandidateOutput, buildFactView } = await load('material-facts-v3.ts');
+const { ingestRuntimeCandidates: fresh } = await load('material-fact-runtime-ingest.ts');
+const { reviewFactsAgainstSources } = await load('material-fact-source-review.ts');
+const cpLength = text => Array.from(text).length;
+const AT = '2026-10-19T04:00:00.000Z';
+const candidate = (value, quote, options = {}) => ({ kind: 'date', value, quote, blockId: 'b1', subject: '王甲', scope: 'individual',
+  meaning: 'payment_date', completeness: 'not_applicable', period: null, rateUnit: null, assertion: 'narrated', ...options });
+console.log(JSON.stringify({ node: process.version, dependency_root: ROOT, event_sha256: createHash('sha256').update(await readFile(EVENT)).digest('hex') }));
+
+function direct(value, text, expected, options = {}) {
+  for (const quote of [value, text]) {
+    const raw = candidate(value, quote, options), normalization = normalizeCandidateValue(raw).normalization;
+    const before = structuredClone({ raw, normalization, text });
+    const actual = attributed(raw, text, normalization);
+    console.log(JSON.stringify({ evidence: 'r40_date_module', raw, text, expected, actual }));
+    assert.equal(actual, expected);
+    assert.deepEqual({ raw, normalization, text }, before);
+  }
+}
+
+function runtime(value, texts, expected, options = {}, pages) {
+  const blocks = (Array.isArray(texts) ? texts : [texts]).map((text, i) => ({ id: `b${i + 1}`, text, page: pages?.[i] ?? 1, bbox: null, confidence: null }));
+  const source = { id: 'r40-date-author', name: 'synthetic.txt', sha256: '4'.repeat(64), ready: true, analysisRevision: 40, blocks };
+  const text = blocks[0].text;
+  for (const quote of [value, text]) {
+    const entry = candidate(value, quote, options), raw = JSON.stringify({ schemaVersion: 3, candidates: [entry] });
+    assert.equal(validateCandidateOutput(raw, source).rejected.length, 0, 'Use the actual valid extraction schema.');
+    const stored = legacy(emptyFactState(40), source, { raw }, 'synthetic', 'fixture', AT);
+    const before = structuredClone({ source, stored });
+    for (const [mode, state] of [['fresh', fresh(emptyFactState(40), source, { raw }, 'synthetic', 'fixture', AT)],
+      ['stored-read', reviewFactsAgainstSources(stored, [source])]]) {
+      assert.equal(state.materials[0].candidates.length, 1);
+      const fact = state.materials[0].candidates[0];
+      console.log(JSON.stringify({ evidence: 'r40_date_source_review', mode, entry, source, fact }));
+      assert.equal(fact.reviewIssues.some(issue => issue.code === 'source_relation_unresolved'), !expected);
+      assert.equal(fact.amount, null);
+      assert.equal(fact.normalization.rawValue, value, 'No missing year is invented in the retained literal.');
+      assert.deepEqual(fact.representation, entry); assert.equal(state.materials[0].raw, raw);
+      const start = cpLength(text.slice(0, text.indexOf(quote)));
+      assert.equal(fact.start, start); assert.equal(fact.end, start + cpLength(quote));
+      assert.equal(Array.from(text).slice(fact.start, fact.end).join(''), quote);
+      assert.deepEqual(state.confirmations, { due: null, paid: null }); assert.equal(state.calculation, null);
+      const view = buildFactView(state, [source]);
+      assert.equal(view.canCalculate, false); assert.deepEqual(view.fields.due.values, []); assert.deepEqual(view.fields.paid.values, []);
+    }
+    assert.deepEqual({ source, stored }, before);
+  }
+}
+
+for (const [value, verb, prep] of [['1月15日', '支付', '于'], ['十二月三十一日', '发放', '在'],
+  ['二月十五日', '給付', '於'], ['１２月３１日', '付清', '于']])
+  test(`yearless point is retained in its complete wage payment envelope: ${value}${verb}`, () => direct(value, `😀王甲工資${prep}${value}${verb}`, true));
+test('the existing year-bearing payment envelope stays supported', () => direct('2026年1月15日', '😀王甲工资于2026年1月15日支付', true));
+for (const join of ['与', '與', '和', '及']) {
+  const value = `2026年1月${join}2月`;
+  test(`complete parallel wage-period list: ${join}`, () => direct(value, `😀王甲${value}工资所属期间`, true, { meaning: 'wage_period' }));
+}
+for (const value of ['13月15日', '0月15日', '1月0日', '1月32日'])
+  test(`new yearless envelope refuses an invalid month/day: ${value}`, () => direct(value, `😀王甲工资于${value}支付`, false));
+for (const [text, options] of [
+  ['😀王甲工资于1月15日未支付', {}], ['😀李乙工资于1月15日支付', {}],
+  ['😀王甲工资于1月15日李乙支付', {}], ['😀王甲工资于1月15日支付', { meaning: 'employment_period' }],
+  ['😀王甲工资于1月15日支付', { meaning: 'wage_period' }], ['😀王甲工资于1月15日支付', { scope: 'organization' }],
+]) test(`yearless date does not borrow polarity, owner, role or scope: ${text} ${JSON.stringify(options)}`, () => direct('1月15日', text, false, options));
+for (const [value, text] of [
+  ['2026年1月', '😀王甲2026年1月与2月工资所属期间'], ['2月', '😀王甲2026年1月与2月工资所属期间'],
+  ['2026年1月与2月', '😀李乙2026年1月与2月工资所属期间'], ['2026年1月与2月', '😀王甲2026年1月与2月李乙工资所属期间'],
+]) test(`parallel-period source must retain every event boundary: ${value} / ${text}`, () => direct(value, text, false, { meaning: 'wage_period' }));
+test('fresh and stored yearless payment date keeps raw precision and never authorizes money', () => runtime('1月15日', '😀王甲工资于1月15日支付。', true));
+test('fresh and stored traditional parallel wage periods keep the whole literal', () => runtime('2026年1月與2月', '😀王甲2026年1月與2月工資所屬期間。', true, { meaning: 'wage_period' }));
+test('fresh and stored invalid yearless dates retain their review issue', () => runtime('1月32日', '😀王甲工资于1月32日支付。', false));
+test('fresh and stored negation cannot become a payment event', () => runtime('1月15日', '😀王甲工资于1月15日未支付。', false));
+test('a different owner cannot complete the located payment date', () => runtime('1月15日', '😀王甲工资于1月15日李乙支付。', false));
+test('a different sentence cannot lend its payment verb', () => runtime('1月15日', '😀王甲工资于1月15日。李乙支付。', false));
+test('a verb on another page cannot complete the yearless payment envelope', () => runtime('1月15日', ['😀王甲工资于1月15日', '支付。'], false, {}, [1, 2]));
diff --git a/scripts/material-facts-v7-round40-double-author.test.mjs b/scripts/material-facts-v7-round40-double-author.test.mjs
new file mode 100644
index 0000000..beeac3c
--- /dev/null
+++ b/scripts/material-facts-v7-round40-double-author.test.mjs
@@ -0,0 +1,131 @@
+// ROUND40: attached 双倍/雙倍 names a multiplier, never the payable result.
+// Synthetic module/runtime/read-time review only; no scorer, model or HTTP.
+import test, { after } from 'node:test';
+import assert from 'node:assert/strict';
+import { cp, mkdtemp, rm } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import { resolve } from 'node:path';
+import { fileURLToPath, pathToFileURL } from 'node:url';
+
+const OWN = fileURLToPath(new URL('../', import.meta.url));
+const BASE = resolve(process.env.MATERIAL_FACT_TEST_ROOT || OWN);
+const PATCH = resolve(process.env.MATERIAL_FACT_PATCH_ROOT || OWN);
+const temporary = await mkdtemp(resolve(tmpdir(), 'anxin-round40-double-'));
+after(() => rm(temporary, { recursive: true, force: true }));
+await cp(resolve(BASE, 'lib'), resolve(temporary, 'lib'), { recursive: true });
+await cp(resolve(PATCH, 'lib/material-fact-arithmetic-review.ts'), resolve(temporary, 'lib/material-fact-arithmetic-review.ts'));
+const load = name => import(pathToFileURL(resolve(temporary, 'lib', name + '.ts')).href);
+const { normalizeMoneyValueV4: money, normalizeCandidateValueV4: candidateValue, canonicalMonetaryExpression: canonical } = await load('material-money-v4');
+const { hasAttachedMoneyArithmetic: arithmetic } = await load('material-fact-arithmetic-review');
+const { emptyFactState, ingestCandidates, validateCandidateOutput, buildFactView } = await load('material-facts-v3');
+const { ingestRuntimeCandidates } = await load('material-fact-runtime-ingest');
+const { reviewFactsAgainstSources } = await load('material-fact-source-review');
+const cpLength = text => Array.from(text).length;
+const minimal = process.env.MATERIAL_FACT_ROUND40_DOUBLE_MINIMAL === '1';
+const AT = '2026-10-19T04:00:00.000Z';
+
+function fixture(expression, { fullQuote = false, fullValue = false, next = null, page = 1,
+  meaning = 'other_money', rateUnit = null } = {}) {
+  const source = { id: 'round40-double', name: '合成附着双倍表达', sha256: '9'.repeat(64), analysisRevision: 40, ready: true,
+    blocks: [{ id: 'b1', page: 1, text: '😀王甲工资' + expression + (next === null ? '。' : ''), bbox: null, confidence: null }] };
+  if (next !== null) source.blocks.push({ id: 'b2', page, text: next, bbox: null, confidence: null });
+  const value = fullValue ? expression : '4000元';
+  const candidate = { kind: 'money', value, quote: fullQuote ? source.blocks[0].text : value, blockId: 'b1', subject: '王甲', scope: 'individual',
+    meaning, completeness: meaning === 'rate' || meaning === 'other_money' ? 'not_applicable' : 'complete',
+    period: null, rateUnit, assertion: 'narrated' };
+  return { source, candidate, raw: JSON.stringify({ schemaVersion: 3, candidates: [candidate] }) };
+}
+
+function check(f, amount, status = null) {
+  const original = structuredClone(f);
+  assert.equal(validateCandidateOutput(f.raw, f.source).rejected.length, 0, 'The candidate must pass the real input schema.');
+  function inspect(state, expected, label) {
+    const material = state.materials[0], fact = material.candidates[0];
+    assert.equal(material.raw, f.raw); assert.equal(material.rejected.length, 0); assert.equal(material.candidates.length, 1);
+    assert.equal(fact.amount, expected, label + ': amount');
+    assert.equal(fact.value, f.candidate.value); assert.equal(fact.quote, f.candidate.quote);
+    assert.deepEqual(fact.representation, f.candidate);
+    const text = f.source.blocks[0].text, start = cpLength(text.slice(0, text.indexOf(f.candidate.quote)));
+    assert.deepEqual([fact.start, fact.end], [start, start + cpLength(f.candidate.quote)]);
+    assert.equal(Array.from(text).slice(fact.start, fact.end).join(''), f.candidate.quote);
+    if (status && label !== 'stored-null') assert.equal(fact.normalization.status, status, label + ': status');
+    assert.deepEqual(state.confirmations, { due: null, paid: null }); assert.equal(state.calculation, null);
+    assert.equal(buildFactView(state, [f.source]).canCalculate, false);
+  }
+  inspect(ingestRuntimeCandidates(emptyFactState(40), f.source, { raw: f.raw }, 'synthetic', 'round40-author', AT), amount, 'fresh');
+  for (const oldAmount of ['4000.00', null]) {
+    const stored = ingestCandidates(emptyFactState(40), f.source, { raw: f.raw }, 'synthetic', 'round40-author', AT);
+    const fact = stored.materials[0].candidates[0];
+    fact.amount = oldAmount;
+    fact.normalization = { rawValue: f.candidate.value, status: oldAmount === null ? 'unsupported' : 'exact', amount: oldAmount,
+      matchedText: f.candidate.value, span: { start: 0, end: cpLength(f.candidate.value) }, reason: 'Unconfirmed synthetic stored observation.' };
+    const before = structuredClone(stored), reviewed = reviewFactsAgainstSources(stored, [f.source]);
+    assert.deepEqual(stored, before, 'Read-time review cannot rewrite storage or original raw.');
+    assert.deepEqual(reviewed.history, before.history);
+    inspect(reviewed, oldAmount === null ? null : amount, oldAmount === null ? 'stored-null' : 'stored-exact');
+  }
+  assert.deepEqual(f, original);
+}
+
+
+const expressions = minimal ? ['4000元的双倍', '4000元的雙倍'] : [
+  '4000元的双倍', '4000元的雙倍', '4000元工资的双倍', '4000元双倍',
+];
+for (const expression of expressions) {
+  test('whole double expression and quote crop cannot borrow the base: ' + expression, () => {
+    const result = money(expression);
+    assert.equal(result.amount, null); assert.equal(result.status, 'unsupported'); assert.equal(result.rawValue, expression);
+    assert.equal(canonical(expression), null);
+    const f = fixture(expression, { fullQuote: true }), crop = candidateValue(f.candidate);
+    assert.equal(crop.amount, null); assert.equal(crop.normalization.status, 'unsupported');
+    assert.equal(crop.value, '4000元'); assert.equal(crop.normalization.rawValue, '4000元');
+  });
+}
+if (!minimal) {
+  for (const expression of expressions) test('fresh and read-time review keep the original operand/raw/CP: ' + expression, () => {
+    for (const fullQuote of [false, true]) check(fixture(expression, { fullQuote }), null, 'unsupported');
+    check(fixture(expression, { fullValue: true }), null, 'unsupported');
+  });
+  test('explicit 的 permits finite layout and format controls in the multiplier', () => {
+    for (const expression of ['4000元的\n双倍', '4000元的雙\n倍', '4000元 的 雙 倍', '4000元的双\u200d倍']) {
+      assert.equal(money(expression).amount, null); check(fixture(expression), null);
+    }
+  });
+  test('an explicit multiplier continues into its same-page adjacent block', () => {
+    for (const next of ['的双倍。', '的雙倍。']) check(fixture('4000元', { next }), null);
+    check(fixture('4000元的双', { next: '倍。' }), null);
+  });
+  test('whole-amount wrappers do not hide an explicit multiplier', () => {
+    for (const expression of ['4000元整的双倍', '4000元正的雙倍', '4000元人民币的双倍']) {
+      assert.equal(money(expression).amount, null); check(fixture(expression), null);
+    }
+  });
+  test('ordinary prose and another event cannot bridge into the operation', () => {
+    for (const tail of ['。李乙工资的双倍', '，另一人雙倍', '\n李乙工资双倍', '工资另行双倍', '双人间', '双休日支付'])
+      assert.equal(arithmetic('', tail), false, tail);
+  });
+  test('separate owner and sentence preserve this amount', () => {
+    for (const expression of ['4000元。李乙工资的双倍', '4000元，李乙工资雙倍']) {
+      assert.equal(money(expression).amount, '4000.00'); check(fixture(expression), '4000.00');
+    }
+    check(fixture('4000元。', { next: '的雙倍。' }), '4000.00');
+  });
+  test('page metadata prevents a double operation from attaching', () => {
+    check(fixture('4000元', { next: '的双倍。', page: 2 }), '4000.00');
+  });
+  test('a bare multiplier on an independent line is not attached', () => {
+    assert.equal(arithmetic('', '\n双倍工资'), false);
+    assert.equal(arithmetic('', '\n雙倍'), false);
+  });
+  test('an explicitly stated result after double wages retains the result', () => {
+    for (const expression of ['双倍工资共4000元', '雙倍工资合计4000元']) {
+      assert.equal(money(expression).amount, '4000.00'); check(fixture(expression), '4000.00');
+    }
+  });
+  test('supported rate and old formulas keep their existing contract', () => {
+    check(fixture('4000元/月', { meaning: 'rate', rateUnit: 'month' }), '4000.00');
+    check(fixture('4000元/月', { meaning: 'due_total' }), null);
+    for (const expression of ['4000元的2倍', '4000元翻一倍', '4000元减半', '4000元折半', '4000元×2', '4000元乘以提成率'])
+      assert.equal(money(expression).amount, null, expression);
+  });
+}
diff --git a/scripts/material-facts-v7-round40-hour-author.test.mjs b/scripts/material-facts-v7-round40-hour-author.test.mjs
new file mode 100644
index 0000000..8a5a2d9
--- /dev/null
+++ b/scripts/material-facts-v7-round40-hour-author.test.mjs
@@ -0,0 +1,57 @@
+// R40 finite hourly classifier regression. Synthetic module/runtime evidence only.
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { resolve } from 'node:path';
+import { fileURLToPath, pathToFileURL } from 'node:url';
+const ROOT = resolve(process.env.MATERIAL_FACT_TEST_ROOT || fileURLToPath(new URL('../', import.meta.url)));
+const load = name => import(pathToFileURL(resolve(ROOT, 'lib', name)).href);
+const { normalizeCandidateValueV4: normalize } = await load('material-money-v4.ts');
+const { ingestRuntimeCandidates: fresh } = await load('material-fact-runtime-ingest.ts');
+const { emptyFactState, ingestCandidates: legacy, buildFactView } = await load('material-facts-v3.ts');
+const { reviewFactsAgainstSources: review } = await load('material-fact-source-review.ts');
+const cp = text => Array.from(text).length, AT = '2026-10-19T05:00:00.000Z';
+const candidate = (value, extra = {}) => ({kind: 'money', value, quote: value, blockId: 'b1', subject: '王甲', scope: 'individual', meaning: 'rate', completeness: 'not_applicable', period: null, rateUnit: 'hour', assertion: 'narrated', ...extra});
+function pipeline(expression, expected, {full = false, extra = {}, next = null} = {}) {
+  const source = {id: 'round40-hour', name: 'synthetic.txt', sha256: '4'.repeat(64), ready: true, analysisRevision: 40,
+    blocks: [{id: 'b1', page: 1, text: `😀王甲${extra.period ?? ''}工资${expression}${next === null ? '。' : ''}`, bbox: null, confidence: null}]};
+  if (next !== null) source.blocks.push({id: 'b2', page: 1, text: next, bbox: null, confidence: null});
+  const entry = candidate(full ? expression : '4000元', extra), raw = JSON.stringify({schemaVersion: 3, candidates: [entry]});
+  const original = structuredClone({source, entry});
+  const history = legacy(emptyFactState(40), source, {raw}, 'synthetic', 'hour-author', AT);
+  const storedFact = history.materials[0].candidates[0]; assert(storedFact);
+  storedFact.amount = '4000.00'; storedFact.normalization = {rawValue: entry.value, amount: '4000.00', status: 'exact', matchedText: entry.value, span: {start: 0, end: cp(entry.value)}, reason: 'Synthetic old exact observation'};
+  const stored = structuredClone(history);
+  for (const state of [fresh(emptyFactState(40), source, {raw}, 'synthetic', 'hour-author', AT), review(history, [source])]) {
+    assert.equal(state.materials[0].candidates.length, 1); const fact = state.materials[0].candidates[0];
+    assert.equal(fact.amount, expected); assert.deepEqual(fact.representation, entry); assert.equal(state.materials[0].raw, raw);
+    const text = source.blocks[0].text, start = cp(text.slice(0, text.indexOf(entry.quote)));
+    assert.deepEqual([fact.start, fact.end], [start, start + cp(entry.quote)]);
+    assert.equal(Array.from(text).slice(fact.start, fact.end).join(''), entry.quote);
+    assert.deepEqual(state.confirmations, {due: null, paid: null}); assert.equal(state.calculation, null);
+    assert.equal(buildFactView(state, [source]).canCalculate, false);
+  }
+  assert.deepEqual(history, stored);
+  storedFact.amount = null; Object.assign(storedFact.normalization, {amount: null, status: 'unsupported', matchedText: null, span: null});
+  const unavailable = structuredClone(history); assert.equal(review(history, [source]).materials[0].candidates[0].amount, null);
+  assert.deepEqual(history, unavailable); assert.deepEqual({source, entry}, original);
+}
+for (const unit of ['每个小时', '/个小时', '每個小時', '/個小時']) {
+  const expression = '4000元' + unit;
+  test('complete hourly classifier preserves literal and denominator: ' + unit, () => {
+    const raw = candidate(expression), before = structuredClone(raw), result = normalize(raw);
+    assert.equal(result.amount, '4000.00'); assert.equal(result.rateUnit, 'hour'); assert.equal(result.normalization.rawValue, expression); assert.deepEqual(raw, before);
+  });
+  for (const full of [true, false]) test(`fresh/history full=${full} hourly classifier ${unit}`, () => pipeline(expression, '4000.00', {full}));
