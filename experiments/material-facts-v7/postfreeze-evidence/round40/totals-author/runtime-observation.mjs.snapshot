import { cp, mkdtemp, rm } from 'node:fs/promises';
import { tmpdir } from 'node:os';
import { resolve } from 'node:path';
import { pathToFileURL } from 'node:url';
const [root,event]=process.argv.slice(2);
const dir=await mkdtemp(resolve(tmpdir(),'anxin-r40-runtime-observation-'));
try {
  await cp(resolve(root,'lib'),resolve(dir,'lib'),{recursive:true});
  await cp(event,resolve(dir,'lib/material-fact-event-review.ts'));
  const load=name=>import(pathToFileURL(resolve(dir,'lib',name)).href);
  const {ingestRuntimeCandidates}=await load('material-fact-runtime-ingest.ts');
  const {emptyFactState,buildFactView}=await load('material-facts-v3.ts');
  const rows=[];
  for(const [role,meaning,amount] of [['应发工资合计','due_total','4000.00'],['实发工资合计','paid_total','3500.00']]){
    const value=amount.slice(0,-3)+'元',text='😀王甲2026年1月'+role+value+'。';
    const source={id:'r40-min',name:'synthetic.txt',sha256:'4'.repeat(64),analysisRevision:40,ready:true,blocks:[{id:'b1',page:1,text,bbox:null,confidence:null}]};
    const item={kind:'money',value,quote:value,blockId:'b1',subject:'王甲',scope:'individual',meaning,completeness:'complete',period:'2026年1月',rateUnit:null,assertion:'narrated'};
    const raw=JSON.stringify({schemaVersion:3,candidates:[item]});
    const state=ingestRuntimeCandidates(emptyFactState(40),source,{raw},'synthetic','fixture','2026-10-19T22:00:00.000Z');
    state.scope={worker:'王甲',employer:'甲公司',start:'2026-01-01',end:'2026-01-31'};
    state.scopeReview={note:'Scope only, no money confirmation',actor:'fixture',at:'2026-10-19T22:00:00.000Z'};
    const view=buildFactView(state,[source]),candidate=state.materials[0].candidates[0];
    rows.push({role,meaning,amount:candidate.amount,issues:candidate.reviewIssues.map(i=>i.code),scope_reviewed_values:view.fields[meaning==='due_total'?'due':'paid'].values,canCalculate:view.canCalculate,raw_preserved:state.materials[0].raw===raw,representation_preserved:JSON.stringify(candidate.representation)===JSON.stringify(item)});
  }
  console.log(JSON.stringify(rows,null,2));
}finally{await rm(dir,{recursive:true,force:true});}
