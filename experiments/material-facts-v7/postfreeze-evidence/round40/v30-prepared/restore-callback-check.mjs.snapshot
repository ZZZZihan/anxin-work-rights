import assert from 'node:assert/strict';
import { createHash } from 'node:crypto';
import { cp, mkdir, mkdtemp, readFile, rm, writeFile } from 'node:fs/promises';
import { tmpdir } from 'node:os';
import { dirname, join, resolve } from 'node:path';
import { pathToFileURL } from 'node:url';

const prepared = resolve(process.argv[2]);
const E = 'experiments/material-facts-v7';
const sha = bytes => createHash('sha256').update(bytes).digest('hex');
const { withCorrectionV29Code } = await import(pathToFileURL(resolve(prepared, E, 'verify-correction-v29.mjs')));
const manifestBytes = await readFile(resolve(prepared, E, 'corrections-v29/manifest.json'));
const manifest = JSON.parse(manifestBytes);
assert.equal(Object.keys(manifest.code_sha256).length, 106);
const fixture = await mkdtemp(join(tmpdir(), 'anxin-v30-prepared-restore106-'));
let owned, count = 0;
try {
  for (const name of ['lib', 'scripts', 'docs', E]) await mkdir(resolve(fixture, name), { recursive: true });
  await writeFile(resolve(fixture, 'package.json'), '{"type":"module"}\n');
  const policyPath = `${E}/historical-execution-policy-v1.mjs`;
  const policy = await readFile(resolve(prepared, policyPath));
  const original = await readFile(resolve(prepared, E, 'result-manifest.json'));
  await mkdir(resolve(fixture, E, 'corrections-v29'), { recursive: true });
  await writeFile(resolve(fixture, E, 'corrections-v29/manifest.json'), manifestBytes);
  await writeFile(resolve(fixture, E, 'result-manifest.json'), original);
  await cp(resolve(prepared, E, 'correction-code-v29'), resolve(fixture, E, 'correction-code-v29'), { recursive: true });
  for (const path of Object.keys(manifest.code_sha256)) {
    const target = resolve(fixture, path);
    await mkdir(dirname(target), { recursive: true });
    await writeFile(target, `Synthetic current-byte drift: ${path}\n`);
  }
  const expected = new Error('Synthetic v29 callback throw; no historical command invoked');
  await assert.rejects(withCorrectionV29Code(async temporary => {
    owned = temporary;
    for (const [path, digest] of Object.entries(manifest.code_sha256)) {
      assert.equal(sha(await readFile(resolve(temporary, path))), digest, path);
      count++;
    }
    assert.deepEqual(await readFile(resolve(temporary, E, 'result-manifest.json')), original);
    assert.deepEqual(await readFile(resolve(temporary, policyPath)), policy);
    throw expected;
  }, fixture), error => error === expected);
  assert(owned);
  await assert.rejects(readFile(resolve(owned, 'package.json')), { code: 'ENOENT' });
  assert.equal(await readFile(resolve(fixture, 'lib/material-money-v4.ts'), 'utf8'),
    'Synthetic current-byte drift: lib/material-money-v4.ts\n');
  console.log(JSON.stringify({ status: 'PASS', restored_paths: count,
    original_result_manifest_sha256: sha(original), policy_sha256: sha(policy),
    callback_error_identity_preserved: true, owned_temporary_removed: true,
    caller_fixture_not_overwritten: true, historical_cli_executed: false,
    scorer_executed: false, model_requests: 0 }));
} finally { await rm(fixture, { recursive: true, force: true }); }
