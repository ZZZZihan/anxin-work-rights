import { readFile, writeFile } from 'node:fs/promises';
process.on('SIGXFSZ', () => {});
const destination = process.argv[2];
const manifest = JSON.parse(await readFile(process.argv[3], 'utf8'));
const writeManifest = true;
try {
  if (writeManifest) await writeFile(destination, JSON.stringify(manifest, null, 2) + '\n', { flag: 'wx' });
  console.log(JSON.stringify({ status: 'PASS' }));
} catch (error) {
  console.log(JSON.stringify({ status: 'FAIL', code: error.code, name: error.name }));
  process.exitCode = 1;
}
