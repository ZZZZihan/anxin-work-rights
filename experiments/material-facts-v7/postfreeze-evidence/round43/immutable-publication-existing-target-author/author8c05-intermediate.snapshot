import assert from 'node:assert/strict';
import { spawn } from 'node:child_process';
import { createHash } from 'node:crypto';
import fs from 'node:fs/promises';
import { tmpdir } from 'node:os';
import { join, resolve } from 'node:path';
import test from 'node:test';
import { fileURLToPath } from 'node:url';

const ROOT = resolve(process.env.MATERIAL_FACT_PUBLICATION_ROOT ?? fileURLToPath(new URL('../', import.meta.url)));
const HELPER = resolve(ROOT, 'experiments/material-facts-v7/immutable-artifact-publication.mjs');
const PAYLOAD = '{"complete":true,"synthetic":true}\n';
const workerSource = `
import fs from 'node:fs/promises';
import { syncBuiltinESMExports } from 'node:module';
import { pathToFileURL } from 'node:url';
const options = JSON.parse(process.argv[2]);
const nativeLink = fs.link, nativeOpen = fs.open, nativeUnlink = fs.unlink;
let linkLost = false;
if (options.barrier) fs.link = async (stage, target) => {
  await fs.writeFile(options.ready, await fs.readFile(stage), { flag: 'wx' });
  const deadline = Date.now() + 5000;
  for (;;) {
    try { await fs.lstat(options.release); break; }
    catch (error) { if (error.code !== 'ENOENT' || Date.now() >= deadline) throw error; }
    await new Promise(resolve => setTimeout(resolve, 5));
  }
  try { return await nativeLink(stage, target); }
  catch (error) { if (error.code === 'EEXIST') linkLost = true; throw error; }
};
if (options.cleanupFailure) fs.unlink = async path => {
  if (linkLost) throw Object.assign(new Error('injected loser cleanup failure'), { code: 'EACCES' });
  return nativeUnlink(path);
};
if (options.fault) fs.open = async (...args) => {
  const handle = await nativeOpen(...args);
  return {
    writeFile: async bytes => {
      if (options.fault === 'write') {
        await handle.writeFile(bytes.slice(0, 7));
        throw Object.assign(new Error('injected partial write'), { code: 'EFBIG' });
      }
      return handle.writeFile(bytes);
    },
    sync: async () => {
      if (options.fault === 'sync') throw Object.assign(new Error('injected sync failure'), { code: 'EIO' });
      return handle.sync();
    },
    close: async () => {
      await handle.close();
      if (options.fault === 'close') throw Object.assign(new Error('injected close failure'), { code: 'EIO' });
    },
  };
};
syncBuiltinESMExports();
const { publishImmutableFile } = await import(pathToFileURL(options.helper).href);
let publication = null, failure = null;
try { publication = await publishImmutableFile(options.target, options.payload); }
catch (error) {
  failure = { name: error.name, code: error.code, message: error.message,
    temporary_path: error.publication_temporary_path ?? null,
    temporary_removed: error.publication_temporary_removed ?? null,
    cleanup_error_code: error.publication_cleanup_error_code ?? null };
}
console.log(JSON.stringify({ publication, failure }));
`;

async function fixture(t) {
  const directory = await fs.mkdtemp(join(tmpdir(), 'anxin-publication-eexist-'));
  t.after(() => fs.rm(directory, { recursive: true, force: true }));
  const results = join(directory, 'results'), control = join(directory, 'external-control');
  await fs.mkdir(results); await fs.mkdir(control);
  const worker = join(control, 'worker.mjs'); await fs.writeFile(worker, workerSource);
  return { directory, results, control, worker, target: join(results, 'report.json') };
}

function launch(file, options = {}) {
  const child = spawn(process.execPath, [file.worker, JSON.stringify({ helper: HELPER, target: file.target, payload: PAYLOAD, ...options })], { stdio: ['ignore', 'pipe', 'pipe'] });
  let stdout = '', stderr = '';
  child.stdout.setEncoding('utf8').on('data', value => { stdout += value; });
  child.stderr.setEncoding('utf8').on('data', value => { stderr += value; });
  const deadline = setTimeout(() => child.kill('SIGKILL'), 10000);
  const completion = new Promise((resolveExit, reject) => {
    child.once('error', reject);
    child.once('close', (code, signal) => {
      try { assert.equal(code, 0, stderr); assert.equal(signal, null); resolveExit(JSON.parse(stdout)); }
      catch (error) { reject(error); }
    });
  }).finally(() => clearTimeout(deadline));
  return { child, completion };
}

async function inventory(directory) {
  const names = (await fs.readdir(directory)).sort();
  return Promise.all(names.map(async name => {
    const path = join(directory, name), info = await fs.lstat(path);
    return { name, type: info.isSymbolicLink() ? 'symlink' : info.isDirectory() ? 'directory' : 'file',
      value: info.isSymbolicLink() ? await fs.readlink(path) : info.isFile() ? createHash('sha256').update(await fs.readFile(path)).digest('hex') : null };
  }));
}

for (const kind of ['file', 'directory', 'symlink', 'dangling-symlink']) {
  test(`an already-existing ${kind} rejects without changing its directory`, async t => {
    const file = await fixture(t);
    if (kind === 'file') await fs.writeFile(file.target, 'original immutable bytes\n');
    if (kind === 'directory') await fs.mkdir(file.target);
    if (kind === 'symlink') {
      const original = join(file.control, 'original.json'); await fs.writeFile(original, 'original linked bytes\n'); await fs.symlink(original, file.target);
    }
    if (kind === 'dangling-symlink') await fs.symlink(join(file.control, 'absent.json'), file.target);
    const before = await inventory(file.results), result = await launch(file).completion;
    assert.equal(result.failure?.code, 'EEXIST'); assert.equal(result.publication, null);
    assert.deepEqual(await inventory(file.results), before, 'Duplicate rejection must have no result-directory side effect');
  });
}

test('a new target still publishes complete immutable bytes and removes its stage', async t => {
  const file = await fixture(t), result = await launch(file).completion;
  assert.equal(result.failure, null); assert.equal(result.publication.published, true); assert.equal(result.publication.temporary_removed, true);
  assert.equal(await fs.readFile(file.target, 'utf8'), PAYLOAD);
  assert.deepEqual((await inventory(file.results)).map(row => row.name), ['report.json']);
});

async function race(t, { cleanupFailure = false } = {}) {
  const file = await fixture(t), release = join(file.control, 'release');
  const ready = [join(file.control, 'ready-a'), join(file.control, 'ready-b')];
  const workers = ready.map(path => launch(file, { barrier: true, ready: path, release, cleanupFailure }));
  const completed = Promise.all(workers.map(worker => worker.completion));
  // Attach the rejection handler immediately while waiting for the link barrier.
  completed.catch(() => {});
  t.after(() => { for (const worker of workers) if (worker.child.exitCode === null) worker.child.kill('SIGKILL'); });
  const deadline = Date.now() + 5000;
  while (!(await Promise.all(ready.map(async path => fs.access(path).then(() => true, () => false)))).every(Boolean)) {
    assert(Date.now() < deadline, 'Both publishers must reach the real native link barrier');
    await new Promise(resolve => setTimeout(resolve, 5));
  }
  for (const path of ready) assert.equal(await fs.readFile(path, 'utf8'), PAYLOAD, 'Each contender has a complete stage before link');
  assert.equal((await inventory(file.results)).filter(row => row.name.endsWith('.stage')).length, 2);
  await fs.writeFile(release, 'release', { flag: 'wx' });
  const attempts = await completed;
  assert.equal(attempts.filter(row => row.publication?.published).length, 1);
  const loser = attempts.find(row => row.failure);
  assert.equal(loser.failure.code, 'EEXIST');
  assert.equal(await fs.readFile(file.target, 'utf8'), PAYLOAD);
  return { file, loser };
}

test('two real native links have one winner and leave only that winner in results', async t => {
  const { file, loser } = await race(t);
  assert.equal(loser.failure.temporary_removed, true);
  assert.deepEqual((await inventory(file.results)).map(row => row.name), ['report.json']);
});

test('loser cleanup failure preserves EEXIST plus cleanup error and owned stage path', async t => {
  const { file, loser } = await race(t, { cleanupFailure: true });
  assert.equal(loser.failure.code, 'EEXIST');
  assert.equal(loser.failure.cleanup_error_code, 'EACCES');
  assert.equal(loser.failure.temporary_removed, false);
  assert.equal(await fs.readFile(loser.failure.temporary_path, 'utf8'), PAYLOAD);
  assert.equal((await inventory(file.results)).filter(row => row.name.endsWith('.stage')).length, 1);
});

for (const fault of ['write', 'sync', 'close']) {
  test(`an actual ${fault} path failure retains its stage and still permits a clean retry`, async t => {
    const file = await fixture(t), failed = await launch(file, { fault }).completion;
    assert.equal(failed.failure.code, fault === 'write' ? 'EFBIG' : 'EIO');
    await assert.rejects(fs.lstat(file.target), { code: 'ENOENT' });
    const names = (await fs.readdir(file.results)).filter(name => name.endsWith('.stage'));
    assert.equal(names.length, 1);
    const stage = join(file.results, names[0]), before = await fs.readFile(stage);
    assert.equal(before.toString(), fault === 'write' ? PAYLOAD.slice(0, 7) : PAYLOAD);
    const retry = await launch(file).completion;
    assert.equal(retry.publication.published, true); assert.equal(retry.failure, null);
    assert.equal(await fs.readFile(file.target, 'utf8'), PAYLOAD);
    assert.deepEqual(await fs.readFile(stage), before, 'Genuine failed-stage evidence remains unchanged');
  });
}
