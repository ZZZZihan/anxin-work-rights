+import test, { after } from 'node:test';
+import assert from 'node:assert/strict';
+import { cp, mkdtemp, rm } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import { resolve } from 'node:path';
+import { fileURLToPath, pathToFileURL } from 'node:url';
+
+// Synthetic source-review acceptance with actual fresh ingestion and historical
+// read-time downgrade. No model, HTTP, original labels/results or stored evidence
+// is changed; the sole implementation overlay is material-fact-source-review.ts.
+const IMPLEMENTATION = fileURLToPath(new URL('../', import.meta.url));
+const SOURCE = resolve(process.env.MATERIAL_FACT_TEST_ROOT || IMPLEMENTATION);
+const temporary = await mkdtemp(resolve(tmpdir(), 'anxin-relative-day-review-'));
+after(() => rm(temporary, { recursive: true, force: true }));
+await cp(resolve(SOURCE, 'lib'), resolve(temporary, 'lib'), { recursive: true });
+await cp(resolve(IMPLEMENTATION, 'lib/material-fact-source-review.ts'), resolve(temporary, 'lib/material-fact-source-review.ts'));
+const load = name => import(pathToFileURL(resolve(temporary, 'lib', name)).href);
+const { reviewCandidateAgainstSource } = await load('material-fact-source-review.ts');
+const { ingestRuntimeCandidates } = await load('material-fact-runtime-ingest.ts');
+const { emptyFactState, ingestCandidates } = await load('material-facts-v3.ts');
+const { ingestCandidates: ingestV2, validateCandidateOutput: validateV2 } = await load('material-facts-v2.ts');
+const { normalizeMoneyValueV4 } = await load('material-money-v4.ts');
+const AT = '2026-10-18T00:00:00.000Z', ACTOR = 'synthetic-owner';
+
+function fixture(text, { subject = '王甲', period = null, meaning = 'arrears', rateUnit = null, fullQuote = false, value = '四万元' } = {}) {
+  const source = { id: 'synthetic-relative-day', name: '合成相对日来源', sha256: 'd'.repeat(64), analysisRevision: 1, ready: true,
+    blocks: [{ id: 'b1', page: 1, text, bbox: null, confidence: null }] };
+  const representation = { kind: 'money', value, quote: fullQuote ? text : value, blockId: 'b1', subject, scope: 'individual', meaning,
+    completeness: 'not_applicable', period, rateUnit, assertion: 'narrated' };
+  const raw = JSON.stringify({ schemaVersion: 3, candidates: [representation] });
+  const state = ingestCandidates(emptyFactState(1), source, { raw }, 'synthetic', ACTOR, AT), candidate = state.materials[0].candidates[0];
+  assert.ok(candidate, 'Synthetic value must enter actual candidate storage');
+  const normalization = normalizeMoneyValueV4(value); assert.equal(normalization.amount, '40000.00');
+  Object.assign(candidate, { amount: normalization.amount, normalization });
+  return { source, state, raw, representation, candidate };
+}
+
+function check(text, settings, expected) {
+  const f = fixture(text, settings), before = structuredClone({ source: f.source, state: f.state });
+  const historical = reviewCandidateAgainstSource(f.candidate, f.source);
+  assert.equal(historical.amount, expected);
+  assert.equal(historical.reviewIssues.some(issue => issue.code === 'rate_unit_mismatch'), expected === null);
+  assert.equal(historical.normalization.status, expected === null ? 'rate_unit_mismatch' : 'exact');
+  assert.deepEqual({ source: f.source, state: f.state }, before, 'Historical stored bytes/fields are untouched');
+  assert.deepEqual(historical.representation, f.representation); assert.equal(historical.value, f.representation.value); assert.equal(historical.quote, f.representation.quote);
+  // Candidate evidence offsets bind quote, which may cover the entire sentence;
+  // source review independently locates value within that unchanged quote.
+  assert.equal(historical.start, Array.from(text.slice(0, text.indexOf(f.representation.quote))).length);
+  assert.equal(historical.end, historical.start + Array.from(f.representation.quote).length);
+  assert.deepEqual(reviewCandidateAgainstSource(historical, f.source), historical);
+  const fresh = ingestRuntimeCandidates(emptyFactState(1), f.source, { raw: f.raw }, 'synthetic', ACTOR, AT);
+  assert.equal(fresh.materials[0].candidates.length, 1); assert.equal(fresh.materials[0].candidates[0].amount, expected);
+  assert.deepEqual(fresh.materials[0].candidates[0].representation, f.representation); assert.equal(fresh.materials[0].raw, f.raw);
+  assert.deepEqual(fresh.confirmations, emptyFactState(1).confirmations);
+}
+
+const days = ['今日', '昨日', '当日', '明日', '本日', '前日', '后日', '该日', '这日', '那日', '次日', '翌日', '同日', '當日', '後日', '該日', '這日'];
+for (const day of days) for (const wage of ['工资合计', '基本工资为']) for (const fullQuote of [false, true]) {
+  test(`${day}${wage} is a period amount (${fullQuote ? 'full' : 'cropped'} quote)`, () => check(`😀王甲${day}${wage}四万元。`, { period: day, fullQuote }, '40000.00'));
+}
+
+for (const day of ['今天', '昨天', '明天', '当天', '这天', '前一日', '后一日', '2026年10月18日', '二〇二六年十月十八日']) {
+  test(`adjacent calendar/relative day wording retains its period amount: ${day}`, () => check(`王甲${day}工资合计四万元。`, { period: day }, '40000.00'));
+}
+
+const rates = ['每日工资', '每天工资', '日薪', '日工资标准为', '日基本工资标准：', '每日基本工资', '今日工资标准为'];
+for (const prefix of rates) for (const fullQuote of [false, true]) {
+  test(`a total cannot hide the daily rate ${prefix} (${fullQuote ? 'full' : 'cropped'} quote)`, () => check(`😀王甲${prefix}四万元。`, { fullQuote }, null));
+  test(`correct daily rate remains available for ${prefix} (${fullQuote ? 'full' : 'cropped'} quote)`, () => check(`王甲${prefix}四万元。`, { meaning: 'rate', rateUnit: 'day', fullQuote }, '40000.00'));
+  test(`a monthly rate cannot borrow ${prefix} (${fullQuote ? 'full' : 'cropped'} quote)`, () => check(`王甲${prefix}四万元。`, { meaning: 'rate', rateUnit: 'month', fullQuote }, null));
+}
+
+for (const day of ['今日', '昨日', '本日']) for (const suffix of ['/日', '每日', '/天']) {
+  test(`explicit daily suffix takes priority over ${day}: ${suffix}`, () => check(`王甲${day}工资合计四万元${suffix}。`, { period: day }, null));
+}
+
+for (const subject of ['王今', '王昨', '王当', '王本', '王明', '今日']) {
+  test(`subject ${subject} cannot make its actual 日工资 into a relative-day total`, () => check(`😀${subject}日工资合计四万元。`, { subject }, null));
+  test(`subject ${subject} retains its correctly declared daily rate`, () => check(`${subject}日工资合计四万元。`, { subject, meaning: 'rate', rateUnit: 'day' }, '40000.00'));
+  test(`a relative date after subject ${subject} still names the period`, () => check(`${subject}今日工资合计四万元。`, { subject, period: '今日' }, '40000.00'));
+}
+test('a subject literally named 今日 does not turn its own wage into a daily rate', () => check('😀今日工资合计四万元。', { subject: '今日' }, '40000.00'));
+
+for (const separator of ['，', '。', '\n', '\u2028', '\u2029']) {
+  test(`another worker daily rate cannot invalidate this relative-day total (${JSON.stringify(separator)})`, () => check(`王乙每日工资三万元${separator}王甲今日工资合计四万元。`, { period: '今日' }, '40000.00'));
+}
+
+test('historical v2 relative-day money remains available without changing stored fields', () => {
+  const f = fixture('😀王甲今日工资合计40000元。', { value: '40000元', period: '今日' });
+  const raw = JSON.stringify({ schemaVersion: 2, candidates: [f.representation] });
+  const state = ingestV2(emptyFactState(1), f.source, validateV2(raw, f.source), 'synthetic', ACTOR, AT), before = structuredClone(state);
+  const reviewed = reviewCandidateAgainstSource(state.materials[0].candidates[0], f.source);
+  assert.equal(reviewed.amount, '40000.00'); assert.ok(!reviewed.reviewIssues.some(issue => issue.code === 'rate_unit_mismatch'));
+  assert.deepEqual(state, before); assert.deepEqual(reviewed.representation, f.representation); assert.equal(Object.hasOwn(reviewed, 'normalization'), false);
+});
